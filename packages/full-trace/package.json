{
  "name": "@sciforge/full-trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secret-safe durable full model and agent tracing for SciForge.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
