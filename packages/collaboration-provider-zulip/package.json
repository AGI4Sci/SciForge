{
  "name": "@sciforge/collaboration-provider-zulip",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "description": "Zulip Human Endpoint Provider adapter for SciForge collaboration.",
  "exports": {
