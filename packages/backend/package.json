{
  "name": "@sciforge/backend",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "SciForge backend compatibility tools for CLI agent runtimes.",
  "sciforge": {
    "lifecycleLayer": "tools",
    "skillFacing": false,
    "sideEffects": "network",
    "publicContract": true,
    "runtimeAdapter": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./codex-compatibility-gate": "./src/codex-compatibility-gate.ts",
    "./runtime-home": "./src/runtime-home.ts",
    "./response-compat": "./src/response-compat.ts"
  },
  "files": [
    "src",
    "runtime-config",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "codex:proxy": "node -e \"console.error('legacy codex:proxy is disabled for active SciForge Runtime/Browser paths; use the workspace backend:model-router script instead.'); process.exit(2)\"",
    "codex:runtime:setup": "tsx src/setup-runtime-home.ts",
    "codex:runtime:exec": "tsx src/exec-runtime-codex.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  }
}
