{
  "schemaVersion": "sciforge.action-provider.manifest.v1",
  "id": "sciforge.browser-runtime",
  "version": "0.1.0",
  "kind": "action",
  "displayName": "SciForge Web Search Runtime",
  "summary": "Codex-compatible web_search ordinary surface with internal or advanced web_read for read-required escalation.",
  "domains": [
    "browser",
    "web"
  ],
  "triggers": [
    "web search",
    "read web page",
    "source evidence"
  ],
  "antiTriggers": [
    "final answer synthesis",
    "task completion judgement",
    "domain-specific research strategy",
    "batch crawling",
    "autonomous browsing"
  ],
  "integrationLevel": "schema-adapter",
  "entrypoint": {
    "type": "typescript-package",
    "package": "@agi4sci/sciforge-browser-runtime-action-provider",
    "module": "packages/actions/browser-runtime/index.ts",
    "symbol": "createBrowserPrimitiveService",
    "path": "packages/actions/browser-runtime",
    "notes": "Direct MCP aliases route through the Browser module dispatcher. web_search is the ordinary Codex-compatible search surface; web_read is internal or advanced, not a required second step for ordinary search."
  },
  "mcpTools": [
    "web_search",
    "web_read"
  ],
  "ordinaryToolSurface": {
    "defaultTool": "web_search",
    "description": "Codex-compatible ordinary search surface. Ordinary search may be satisfied by current-run web_search results plus final-answer source links.",
    "webReadRole": "web_read is internal or advanced for URL summaries, direct quotes, page-level verification, diagnostics, fallback adapters, low-information results, or conflicting sources."
  },
  "excludedAgentTools": [
    {
      "name": "web_extract",
      "reason": "Not part of the P0 default tool surface."
    },
    {
      "name": "web_batch_read",
      "reason": "Batching is owned by Agent Host or callers through parallel web_read calls."
    },
    {
      "name": "web_health",
      "reason": "Runtime resource or management endpoint, not a normal Agent tool."
    },
    {
      "name": "web_benchmark",
      "reason": "CLI/development acceptance utility, not a normal Agent tool."
    }
  ],
  "actionSchema": {
    "schemaRef": "sciforge.browser-runtime.web-tool-result.v1",
    "inputShape": {
      "oneOf": [
        {
          "title": "web_search",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "language": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "time_range": {
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            },
            "safe_search": {
              "enum": [
                "off",
                "moderate",
                "strict"
              ]
            },
            "provider": {
              "type": "string"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowedDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "blockedDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "title": "web_read",
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "resourceRef"
              ]
            }
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "HTTP(S) URL only; localhost, private IPs, file:, and special protocols fail closed."
            },
            "resourceRef": {
              "type": "string",
              "description": "Discovered candidate page ref from web_search, formatted as web-page:{id}."
            },
            "format": {
              "enum": [
                "markdown",
                "text",
                "html",
                "metadata"
              ]
            },
            "render": {
              "enum": [
                "auto",
                "static",
                "browser"
              ]
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "cache_policy": {
              "enum": [
                "default",
                "bypass",
                "refresh"
              ]
            },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowedDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "blockedDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "outputShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "status",
        "tool",
        "refs",
        "timings",
        "warnings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sciforge.browser-runtime.web-tool-result.v1"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "blocked",
            "needs-confirmation",
            "failed"
          ]
        },
        "tool": {
          "enum": [
            "web_search",
            "web_read"
          ]
        },
        "provider": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "description": "web_search data contains ordinary search results, snippets, candidate refs, and source links; web_read data contains single-page source metadata and bounded content preview/ref metadata for internal or advanced read-required paths."
        },
        "refs": {
          "type": "array",
          "description": "Refs-first ledger. web-search:{id} and web-page:{id} identify result sets and source links for ordinary search; web-source:{id} and web-text:{id} are source evidence refs produced by internal or advanced web_read.",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "kind",
              "evidence"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "search_result_set",
                  "discovered_page",
                  "source_page",
                  "page_text",
                  "html",
                  "diagnostic"
                ]
              },
              "evidence": {
                "enum": [
                  "candidate",
                  "source",
                  "diagnostic"
                ]
              },
              "locator": {
                "type": "object"
              },
              "title": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "timings": {
          "type": "object"
        },
        "warnings": {
          "type": "array"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_input",
                "unsafe_url",
                "provider_unavailable",
                "timeout",
                "rate_limited",
                "no_results",
                "read_failed",
                "extract_failed",
                "needs_browser",
                "needs_user_browser"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provider": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "environmentTargets": [
    {
      "type": "network",
      "coordinatePolicy": "provider-defined",
      "sideEffects": [
        "search-provider-request",
        "single-url-fetch-or-render"
      ],
      "isolation": "Host-provided Browser Runtime ports and refs-first artifact storage"
    }
  ],
  "safetyGates": {
    "riskClass": "medium",
    "defaultPolicy": "fail-closed-on-unsafe-url",
    "highRiskPolicy": "fail-closed",
    "supportsDryRun": false,
    "blockedActions": [
      "localhost-or-private-network-url",
      "file-url-or-special-protocol",
      "credential-entry",
      "captcha-or-login-bypass",
      "autonomous-cross-site-crawling"
    ],
    "requiresExplicitTarget": true,
    "notes": "Agent Host owns intent, source policy, evidence sufficiency, repair, final answer, and completion truth."
  },
  "traceContract": {
    "schemaRef": "sciforge.browser-runtime.web-tool-result.v1",
    "storagePolicy": "ref-only",
    "eventTypes": [
      "web_search",
      "web_read"
    ],
    "redaction": [
      "raw-html-large-payload",
      "cookies",
      "credentials",
      "downloaded-file-bytes",
      "base64"
    ],
    "retention": "session-scoped artifacts with refs-first summaries"
  },
  "verifierContract": {
    "required": false,
    "defaultVerifierTypes": [
      "schema-test"
    ],
    "notes": "Ordinary search verification may use current-run web_search results and final-answer source links. URL summaries, direct quotes, page-level verification, low-information results, or conflicting sources require read-required escalation through internal or advanced web_read."
  }
}
