{
  "schemaVersion": "sciforge.computer-use.adapter-registry-manifest.v1",
  "id": "sciforge.computer-use.virtual-app-screen.adapter-registry",
  "version": "0.1.0",
  "activeProductGate": "virtual-app-screen-user-acceptance",
  "manifestRef": "packages/actions/computer-use/adapter-registry.manifest.json",
  "summary": "Refs-first registry for VirtualAppScreen adapter profiles, query/read behavior, and fail-closed diagnostics.",
  "refsFirst": true,
  "failClosed": true,
  "readinessSchemaRef": "sciforge.computer-use.action-adapter-readiness.v1",
  "userAcceptanceManifestSchemaRef": "sciforge.computer-use.virtual-app-screen-user-acceptance-manifest.v1",
  "diagnosticTaxonomyRef": "adapter-registry:diagnostics/virtual-app-screen-failures",
  "claimLimit": "A registry profile is declaration metadata only. User-level acceptance still requires current session, adapter readiness, permission, before/after frame, executor, verifier, artifact, gui.present, replay, evidence ledger, and isolation refs.",
  "requiredProfileFields": [
    "profileId",
    "profileRef",
    "adapterKind",
    "targetScope",
    "targetAppKinds",
    "supportedActions",
    "capabilityIds",
    "captureSupported",
    "backgroundRenderable",
    "affectsPhysicalDisplay",
    "requiresFocusSteal",
    "sharedSystemInputUsed",
    "blockedReason",
    "schemaRefs"
  ],
  "requiredReadinessFields": [
    "adapterKind",
    "targetScope",
    "supportedActions",
    "captureSupported",
    "backgroundRenderable",
    "affectsPhysicalDisplay",
    "requiresFocusSteal",
    "sharedSystemInputUsed",
    "blockedReason",
    "schemaRefs"
  ],
  "operations": {
    "describe": {
      "operationId": "adapter-registry.describe",
      "input": "none",
      "returns": [
        "schemaVersion",
        "activeProductGate",
        "profileRefs",
        "capabilityRefs",
        "diagnosticTaxonomyRef",
        "lookupPolicy"
      ],
      "payloadPolicy": "refs-and-compact-summaries-only"
    },
    "query": {
      "operationId": "adapter-registry.query",
      "inputFilters": [
        "profileId",
        "adapterKind",
        "targetScope",
        "targetAppKind",
        "capabilityId",
        "supportedAction"
      ],
      "emptyResultPolicy": "blocked-diagnostic",
      "unknownCapabilityPolicy": "fail-closed",
      "payloadPolicy": "profile-refs-only"
    },
    "read": {
      "operationId": "adapter-registry.read",
      "inputKey": "profileId",
      "unknownProfilePolicy": "fail-closed",
      "payloadPolicy": "single-profile-summary-and-refs"
    }
  },
  "lookupPolicy": {
    "declaredAdapterRequired": true,
    "declaredCapabilityRequired": true,
    "undeclaredAdapter": {
      "status": "blocked",
      "diagnosticCategory": "adapter-unavailable",
      "blockedReason": "Adapter profile is not declared in adapter-registry.manifest.json.",
      "userAcceptanceEligible": false,
      "diagnosticOnly": true
    },
    "undeclaredCapability": {
      "status": "blocked",
      "diagnosticCategory": "adapter-unavailable",
      "blockedReason": "Adapter capability is not declared in adapter-registry.manifest.json.",
      "userAcceptanceEligible": false,
      "diagnosticOnly": true
    },
    "ambiguousQuery": {
      "status": "blocked",
      "diagnosticCategory": "target-ambiguous",
      "blockedReason": "Adapter query matched multiple target profiles without a stable target ref.",
      "userAcceptanceEligible": false,
      "diagnosticOnly": true
    }
  },
  "sourceBoundaryPolicy": {
    "allowedAsObservationHints": [
      "browser-runtime-dom-ax-observation",
      "accessibility-tree",
      "playwright-evaluate",
      "ocr",
      "window-inventory"
    ],
    "forbiddenAsUserLevelPass": [
      "dom",
      "playwright",
      "accessibility",
      "shell-only",
      "shell-direct-artifact-write",
      "old-trace",
      "fixture"
    ],
    "requiredComputerUseChain": [
      "observe",
      "ground",
      "propose",
      "lease",
      "execute",
      "verify",
      "before-after-evidence",
      "artifact-validator",
      "gui.present"
    ]
  },
  "capabilities": [
    {
      "capabilityId": "session.attach",
      "capabilityRef": "adapter-capability:virtual-app-screen/session.attach",
      "requiredRefs": ["sessionRef", "targetAppRef", "targetWindowRef"],
      "failureDiagnostic": "no-session"
    },
    {
      "capabilityId": "adapter.ready",
      "capabilityRef": "adapter-capability:virtual-app-screen/adapter.ready",
      "requiredRefs": ["adapterReadinessRef", "capabilityRef"],
      "failureDiagnostic": "adapter-unavailable"
    },
    {
      "capabilityId": "capture.background-frame",
      "capabilityRef": "adapter-capability:virtual-app-screen/capture.background-frame",
      "requiredRefs": ["currentFrameRef", "frameStreamRef"],
      "readinessField": "backgroundRenderable",
      "failureDiagnostic": "background-rendering-unavailable"
    },
    {
      "capabilityId": "permission.preflight",
      "capabilityRef": "adapter-capability:virtual-app-screen/permission.preflight",
      "requiredRefs": ["sessionPermissionRef", "appWindowAllowlistRef", "riskPreviewRef"],
      "failureDiagnostic": "permission-missing"
    },
    {
      "capabilityId": "target.resolve",
      "capabilityRef": "adapter-capability:virtual-app-screen/target.resolve",
      "requiredRefs": ["targetAppRef", "targetWindowRef", "groundingRefs"],
      "failureDiagnostic": "target-ambiguous"
    },
    {
      "capabilityId": "input.execute-isolated",
      "capabilityRef": "adapter-capability:virtual-app-screen/input.execute-isolated",
      "requiredRefs": ["inputIntentRef", "inputLeaseRef", "executorEventRef"],
      "readinessFields": ["affectsPhysicalDisplay", "requiresFocusSteal", "sharedSystemInputUsed"],
      "failureDiagnostic": "isolation-failed"
    },
    {
      "capabilityId": "verify.after",
      "capabilityRef": "adapter-capability:virtual-app-screen/verify.after",
      "requiredRefs": ["beforeAfterFrameRef", "verificationRef"],
      "failureDiagnostic": "verification-failed"
    },
    {
      "capabilityId": "artifact.current-run",
      "capabilityRef": "adapter-capability:virtual-app-screen/artifact.current-run",
      "requiredRefs": ["artifactRef", "artifactValidationRef", "evidenceLedgerRef"],
      "failureDiagnostic": "artifact-missing"
    },
    {
      "capabilityId": "approval.confirmation-boundary",
      "capabilityRef": "adapter-capability:virtual-app-screen/approval.confirmation-boundary",
      "requiredRefs": ["approvalRequestRef", "riskPreviewRef"],
      "failureDiagnostic": "needs-confirmation"
    },
    {
      "capabilityId": "handoff.user-control",
      "capabilityRef": "adapter-capability:virtual-app-screen/handoff.user-control",
      "requiredRefs": ["handoffRef", "blockedRef", "errorRef"],
      "failureDiagnostic": "user-handoff-required"
    }
  ],
  "profiles": [
    {
      "profileId": "browser-research-native-window",
      "profileRef": "adapter-profile:virtual-app-screen/browser-research-native-window",
      "displayName": "Browser research native window",
      "adapterId": "sciforge.computer-use.adapters.browser-research-native-window",
      "adapterKind": "native-window",
      "targetScope": "window",
      "targetAppKinds": ["browser", "research-browser"],
      "adapterSourceKinds": ["native-sidecar", "browser-runtime-dom-ax-observation-hint"],
      "supportedActions": ["click", "type_text", "scroll", "hotkey", "menu_command"],
      "capabilityIds": [
        "session.attach",
        "adapter.ready",
        "capture.background-frame",
        "permission.preflight",
        "target.resolve",
        "input.execute-isolated",
        "verify.after",
        "artifact.current-run",
        "approval.confirmation-boundary",
        "handoff.user-control"
      ],
      "captureSupported": true,
      "backgroundRenderable": true,
      "affectsPhysicalDisplay": false,
      "requiresFocusSteal": false,
      "sharedSystemInputUsed": false,
      "physicalPopupShown": false,
      "blockedReason": null,
      "schemaRefs": [
        "sciforge.computer-use.action-adapter-readiness.v1",
        "sciforge.computer-use.input-intent.v1",
        "sciforge.computer-use.virtual-app-screen-user-acceptance-manifest.v1"
      ],
      "readinessTemplateRef": "adapter-readiness-template:virtual-app-screen/browser-research-native-window",
      "claimLimit": "BrowserRuntime DOM/AX/Playwright refs may ground targets only; they cannot execute or pass user-level acceptance without the Computer Use chain."
    },
    {
      "profileId": "terminal-experiment-native-window",
      "profileRef": "adapter-profile:virtual-app-screen/terminal-experiment-native-window",
      "displayName": "Terminal experiment native window",
      "adapterId": "sciforge.computer-use.adapters.terminal-experiment-native-window",
      "adapterKind": "native-window",
      "targetScope": "window",
      "targetAppKinds": ["terminal", "shell-session"],
      "adapterSourceKinds": ["native-sidecar", "terminal-observation"],
      "supportedActions": ["click", "type_text", "hotkey", "menu_command"],
      "capabilityIds": [
        "session.attach",
