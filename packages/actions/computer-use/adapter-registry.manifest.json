  ],
  "diagnosticTaxonomy": {
    "schemaRef": "sciforge.computer-use.virtual-app-screen-diagnostic-taxonomy.v1",
    "taxonomyRef": "adapter-registry:diagnostics/virtual-app-screen-failures",
    "categories": [
      {
        "category": "no-session",
        "status": "blocked",
        "blockedReasonTemplate": "No active VirtualAppScreen session is attached.",
        "requiredRefs": ["blockedRef", "errorRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": true
      },
      {
        "category": "adapter-unavailable",
        "status": "blocked",
        "blockedReasonTemplate": "No declared adapter profile or readiness record can satisfy the requested action.",
        "requiredRefs": ["adapterRegistryRef", "blockedRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": true
      },
      {
        "category": "background-rendering-unavailable",
        "status": "blocked",
        "blockedReasonTemplate": "The target adapter cannot render a background frame without physical display side effects.",
        "requiredRefs": ["adapterReadinessRef", "blockedRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": true
      },
      {
        "category": "permission-missing",
        "status": "blocked",
        "blockedReasonTemplate": "Required session, screen recording, accessibility, or app-window permission is missing.",
        "requiredRefs": ["sessionPermissionRef", "blockedRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": true
      },
      {
        "category": "target-ambiguous",
        "status": "blocked",
        "blockedReasonTemplate": "The target app/window/region is ambiguous and needs a stable target ref before execution.",
        "requiredRefs": ["targetAppRef", "targetWindowRef", "blockedRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": true
      },
      {
        "category": "verification-failed",
        "status": "blocked",
        "blockedReasonTemplate": "After evidence or verifier refs did not prove the requested user-visible change.",
        "requiredRefs": ["beforeAfterFrameRef", "verificationRef", "blockedRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": true
      },
      {
        "category": "artifact-missing",
        "status": "blocked",
        "blockedReasonTemplate": "The current run did not produce a user-facing artifact ref with validator evidence.",
        "requiredRefs": ["artifactRef", "artifactValidationRef", "blockedRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": true
      },
      {
        "category": "isolation-failed",
        "status": "requires-handoff",
        "blockedReasonTemplate": "The adapter would affect physical display, steal focus, use shared input, or move the system pointer/keyboard.",
        "requiredRefs": ["adapterReadinessRef", "isolationReportRef", "handoffRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": false
      },
      {
        "category": "needs-confirmation",
        "status": "needs-confirmation",
        "blockedReasonTemplate": "The next action requires explicit user confirmation before execution.",
        "requiredRefs": ["approvalRequestRef", "riskPreviewRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": false
      },
      {
        "category": "user-handoff-required",
        "status": "requires-handoff",
        "blockedReasonTemplate": "The task requires user handoff because no isolated adapter can complete it safely.",
        "requiredRefs": ["handoffRef", "blockedRef", "errorRef"],
        "userAcceptanceEligible": false,
        "diagnosticOnly": false
      }
    ]
  }
}
