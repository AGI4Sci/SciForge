      "readinessTemplateRef": "adapter-readiness-template:virtual-app-screen/terminal-experiment-native-window",
      "claimLimit": "Shell commands may be represented as visible terminal input only; shell-only artifact writes cannot satisfy user-level acceptance."
    },
    {
      "profileId": "notebook-jupyter-app-window",
      "profileRef": "adapter-profile:virtual-app-screen/notebook-jupyter-app-window",
      "displayName": "Jupyter notebook app window",
      "adapterId": "sciforge.computer-use.adapters.notebook-jupyter-app-window",
      "adapterKind": "app-window",
      "targetScope": "window",
      "targetAppKinds": ["jupyter", "notebook", "browser-notebook"],
