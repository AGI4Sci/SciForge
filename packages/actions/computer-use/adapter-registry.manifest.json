      "displayName": "PDF or reference viewer native window",
      "adapterId": "sciforge.computer-use.adapters.pdf-reference-viewer-native-window",
      "adapterKind": "native-window",
      "targetScope": "window",
      "targetAppKinds": ["pdf-viewer", "preview", "zotero", "reference-manager"],
      "adapterSourceKinds": ["native-sidecar", "ocr", "document-text-observation-hint"],
      "supportedActions": ["click", "scroll", "hotkey", "menu_command"],
