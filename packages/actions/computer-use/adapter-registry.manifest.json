      ],
      "captureSupported": true,
      "backgroundRenderable": true,
      "affectsPhysicalDisplay": false,
      "requiresFocusSteal": false,
      "sharedSystemInputUsed": false,
      "physicalPopupShown": false,
      "blockedReason": null,
      "schemaRefs": [
        "sciforge.computer-use.action-adapter-readiness.v1",
        "sciforge.computer-use.input-intent.v1",
        "sciforge.computer-use.virtual-app-screen-user-acceptance-manifest.v1"
      ],
      "readinessTemplateRef": "adapter-readiness-template:virtual-app-screen/notebook-jupyter-app-window",
      "claimLimit": "Notebook DOM and kernel metadata are observation hints only unless paired with visible app input, after frames, verifier refs, and artifact refs."
    },
    {
      "profileId": "editor-cursor-app-window",
      "profileRef": "adapter-profile:virtual-app-screen/editor-cursor-app-window",
      "displayName": "Editor or Cursor app window",
      "adapterId": "sciforge.computer-use.adapters.editor-cursor-app-window",
      "adapterKind": "app-window",
      "targetScope": "window",
      "targetAppKinds": ["editor", "cursor", "code-editor"],
      "adapterSourceKinds": ["native-sidecar", "accessibility-observation-hint"],
      "supportedActions": ["click", "type_text", "scroll", "hotkey", "menu_command"],
      "capabilityIds": [
        "session.attach",
        "adapter.ready",
        "capture.background-frame",
        "permission.preflight",
        "target.resolve",
        "input.execute-isolated",
        "verify.after",
        "artifact.current-run",
        "approval.confirmation-boundary",
        "handoff.user-control"
      ],
      "captureSupported": true,
      "backgroundRenderable": true,
      "affectsPhysicalDisplay": false,
      "requiresFocusSteal": false,
      "sharedSystemInputUsed": false,
      "physicalPopupShown": false,
      "blockedReason": null,
      "schemaRefs": [
        "sciforge.computer-use.action-adapter-readiness.v1",
        "sciforge.computer-use.input-intent.v1",
        "sciforge.computer-use.virtual-app-screen-user-acceptance-manifest.v1"
      ],
      "readinessTemplateRef": "adapter-readiness-template:virtual-app-screen/editor-cursor-app-window",
      "claimLimit": "Editor-private APIs, workspace direct writes, and clipboard shortcuts cannot replace visible app-scoped input evidence."
    },
    {
      "profileId": "vscode-local-native-virtual-display",
      "profileRef": "adapter-profile:virtual-app-screen/vscode-local-native-virtual-display",
      "displayName": "VSCode local native virtual display",
      "adapterId": "sciforge.computer-use.adapters.vscode-local-native-virtual-display",
      "adapterKind": "virtual-display-provider",
      "targetScope": "virtual-app-screen",
      "targetAppKinds": ["vscode", "editor", "code-editor"],
      "adapterSourceKinds": ["virtual-display-provider", "local-native-app-provider"],
      "providerIds": [
        "virtual-display.macos.cgvirtualdisplay-screencapturekit",
        "virtual-display.linux.xpra",
        "virtual-display.windows.idd"
      ],
      "providerReadinessRef": "provider-readiness-template:virtual-app-screen/vscode-local-native-virtual-display",
      "surfaceTransport": "webrtc",
      "liveSurfaceRef": "live-surface-template:virtual-app-screen/vscode-local-native-virtual-display",
      "frameStreamRef": "frame-stream-template:virtual-app-screen/vscode-local-native-virtual-display",
      "singleInteractiveTruth": true,
      "supportedActions": ["click", "type_text", "scroll", "hotkey", "menu_command"],
      "capabilityIds": [
        "session.attach",
        "adapter.ready",
