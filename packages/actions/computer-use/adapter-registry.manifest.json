      "affectsPhysicalDisplay": false,
      "requiresFocusSteal": false,
      "sharedSystemInputUsed": false,
      "physicalPopupShown": false,
      "blockedReason": null,
      "schemaRefs": [
        "sciforge.computer-use.action-adapter-readiness.v1",
        "sciforge.computer-use.input-intent.v1",
        "sciforge.computer-use.virtual-app-screen-user-acceptance-manifest.v1"
