      "schemaRefs": [
        "sciforge.computer-use.action-adapter-readiness.v1",
        "sciforge.computer-use.input-intent.v1",
        "sciforge.computer-use.virtual-app-screen-user-acceptance-manifest.v1",
        "sciforge.virtual-display.readiness.v1"
      ],
      "readinessTemplateRef": "adapter-readiness-template:virtual-app-screen/vscode-local-native-virtual-display",
      "claimLimit": "VSCode VirtualAppScreen acceptance requires a ready local native VirtualDisplayProvider and current-session live frame, InputIntent, executor event, before/after, verifier, GUI-present, replay, and evidence-ledger refs."
    },
