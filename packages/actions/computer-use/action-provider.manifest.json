{
  "schemaVersion": "sciforge.action-provider.manifest.v1",
  "id": "sciforge.computer-use",
  "version": "0.1.0",
  "kind": "action",
  "displayName": "SciForge Computer Use",
  "summary": "面向 GUI 的 refs-first Computer Use action loop；真实桌面完成必须由 host-provided target-bound ports 和 evidence 证明。",
  "domains": [
    "gui",
    "automation",
    "workspace"
  ],
  "triggers": [
    "operate GUI",
    "click",
    "type",
    "scroll",
    "press key",
    "window-bound action"
  ],
  "antiTriggers": [
    "vision-only question",
    "artifact rendering",
    "schema-only validation"
  ],
  "integrationLevel": "package-local-host-ports",
  "entrypoint": {
    "type": "typescript-package",
    "package": "@agi4sci/sciforge-computer-use-action-provider",
    "module": "packages/actions/computer-use/host-adapter-contract.ts",
    "symbol": "createComputerUseHostAdapter",
    "path": "packages/actions/computer-use",
    "interface": "createComputerUseHostAdapter({ hostPorts, dispatchHostPort })",
    "productRoute": "Agent Host -> WindowActionSession -> TypeScript host-port contract -> current evidence bundle",
    "notes": "Computer Use product/default acceptance is TS-only and consumes refs-first host ports plus WindowAction evidence projection."
  },
  "actionSchema": {
    "schemaRef": "sciforge.computer-use.request.v1",
    "inputShape": {
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "schema_version": {
          "const": "sciforge.computer-use.request.v1"
        },
        "task": {
          "type": "string"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "default": 12
        },
        "risk_policy": {
          "enum": [
            "fail-closed",
            "allow-confirmed"
          ]
        },
        "approval_ref": {
          "type": "string"
        },
        "providers": {
          "type": "object",
          "properties": {
            "sense": {
              "type": "string"
            },
            "grounder": {
              "type": "string"
            },
            "executor": {
              "type": "string"
            },
            "verifier": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "window_target": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "outputShape": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "reason",
        "steps",
        "traceRefs",
        "screenshotRefs",
        "artifactRefs"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sciforge.computer-use.result.v1"
        },
        "status": {
          "enum": [
            "completed",
            "failed-with-reason",
            "needs-confirmation",
            "max-steps"
          ]
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "steps": {
          "type": "array"
        },
        "finalObservationRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_observation": {
          "type": [
            "object",
            "null"
          ]
        },
        "traceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screenshotRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finalArtifactRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "finalArtifactRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvalRequest": {
          "type": [
            "object",
            "null"
          ]
        },
        "approval_request": {
          "type": [
            "object",
            "null"
          ]
        },
        "failureDiagnostics": {
          "type": "object"
        },
        "failure_diagnostics": {
          "type": "object"
        },
        "targetPointerStateRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetKeyboardStateRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetInputEventLogRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "pointerEventLogRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "keyboardEventLogRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputEventLogRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceLogRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceSnapshotRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceIndexRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "plannerBriefRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifactMetadata": {
          "type": "object"
        },
        "metrics": {
          "type": "object"
        },
        "budgetDebits": {
          "type": "array"
        },
        "budgetDebitRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "examples": [
      {
        "task": "点击目标窗口中可见的搜索框",
        "max_steps": 3,
        "risk_policy": "fail-closed",
        "window_target": {
          "titleContains": "SciForge"
        }
      }
    ]
  },
  "environmentTargets": [
    {
      "type": "window",
      "coordinatePolicy": "window-bound",
      "sideEffects": [
        "pointer",
        "keyboard",
        "focused-window-state"
      ],
      "isolation": "观察、坐标映射和执行都必须绑定目标窗口或窗口内容坐标。"
    },
    {
      "type": "remote-desktop",
      "coordinatePolicy": "provider-defined",
      "sideEffects": [
        "remote-pointer",
        "remote-keyboard"
      ],
      "isolation": "远程会话必须隔离输入通道和 trace。"
    }
  ],
  "safetyGates": {
    "riskClass": "high",
    "defaultPolicy": "fail-closed",
    "highRiskPolicy": "fail-closed",
    "supportsDryRun": true,
    "blockedActions": [
      "payment",
      "credential-change",
      "destructive-delete",
      "external-send-without-approval"
    ],
    "requiresExplicitTarget": true,
    "notes": "旧实现中 high risk action 在 fail-closed 策略下返回 needs-confirmation，不执行。"
  },
  "confirmationRules": {
    "requiredWhen": [
      "riskLevel=high",
      "external side effect",
      "destructive action",
      "approvalPolicy missing"
    ],
    "approvalEvidence": [
      "ComputerUseRequest.risk_policy=allow-confirmed",
      "ComputerUseRequest.approval_ref"
    ],
    "timeoutPolicy": "fail"
  },
  "hostPortsContract": {
    "schemaRef": "sciforge.computer-use.host-ports.v1",
    "policySource": "packages/actions/computer-use/provider-policy.ts",
    "requiredPorts": [
      "capture",
      "plan",
      "locate",
      "execute",
      "verify"
    ],
    "optionalPorts": [
      "crop",
      "query",
      "writeTrace",
      "emitEvent"
    ],
    "realDesktopEvidenceRequiredPorts": [
      "capture",
      "plan",
      "locate",
      "execute",
      "verify",
      "writeTrace",
      "emitEvent"
    ],
    "forbiddenPorts": [
      "requestApproval",
      "gui.present",
      "gui.ask_user"
    ],
    "providerIdPolicy": {
      "capture": [
        "display-capture",
        "target-window-capture",
        "historical-frame-evidence-reader"
      ],
      "crop": "host-focus-region-crop",
      "plan": "model-router.capability.computer-use.planner",
      "locate": "model-router.capability.computer-use.grounding-translator",
      "actionRequestExecutor": [
        "dry-run-generic-gui-executor",
        "package-target-bound-window-executor",
        "<desktopPlatform>-host-port-executor"
      ],
      "execute": [
        "dry-run-generic-gui-executor",
        "virtual-input-state-executor",
        "target-bound-scoped-input-provider",
        "package-target-bound-window-executor",
        "<desktopPlatform>-generic-gui-executor"
      ],
      "verify": "model-router.capability.computer-use.verifier-translator",
      "writeTrace": "workspace-file-ref-trace-writer",
      "emitEvent": "workspace-runtime-events"
    },
    "executorAdapterContract": {
      "schemaRef": "sciforge.computer-use.virtual-input-adapter-manifest.v1",
      "requiredStatus": "independent-simulated-input-adapter",
      "requiredSideEffects": {
        "realOsInput": false,
        "sharedSystemInput": false,
        "systemPointerMove": false,
        "systemKeyboardEvent": false
      },
      "stateRefs": [
        "virtualInputStateRef",
        "virtualPointerStateRef",
        "virtualKeyboardStateRef",
        "targetPointerStateRef",
        "targetKeyboardStateRef",
        "targetInputEventLogRef"
      ],
      "bindingManifestSchema": "sciforge.computer-use.input-adapter-target-binding.v1",
      "adapterManifestValidationSchema": "sciforge.computer-use.input-adapter-manifest-validation.v1",
      "bindingValidationSchema": "sciforge.computer-use.input-adapter-target-binding-validation.v1",
      "bindingRequiredRefs": [
        "adapterManifestRef",
        "targetWindowRef",
        "evidenceRefs"
      ],
      "bindingClaimLimit": "Target binding validation is required for real desktop preflight readiness, but is not B/C/verifier completion evidence.",
      "targetBindingRequiredForRealDesktopEvidence": true,
      "readyInputChannels": [
        "isolated-window",
        "target-bound-simulated-input",
        "independent-simulated-input-adapter",
        "remote-desktop-isolated-session"
      ],
      "diagnosticExecutorProvidersBlockedForReady": [
        "native-stdio-fail-closed-executor",
        "fail-closed-executor",
        "diagnostic-fail-closed-executor",
        "virtual-input-state-executor"
      ],
      "shortcutExecutorProvidersBlockedForReady": [
        "shell-direct-file-write",
        "accessibility-tree",
        "ax",
        "applescript",
        "dom",
        "playwright",
        "private-api",
        "clipboard"
      ],
      "diagnosticOnlyUntilHostBound": true
    },
    "stdioProtocol": {
      "callSchema": "sciforge.computer-use.host-port-call.v1",
      "resultSchema": "sciforge.computer-use.host-port-result.v1",
      "finalResultSchema": "sciforge.computer-use.cli-final-result.v1"
    },
    "nativeMultiScreenSidecarProtocol": {
      "callSchema": "sciforge.computer-use.native-sidecar-dispatch-call.v1",
      "resultSchema": "sciforge.computer-use.platform-sidecar-result.v1",
      "requiredDiscoveryTools": [
        "capabilities",
        "discover"
      ],
      "requiredExecutionTools": [
        "preflight",
        "capture",
        "state",
        "execute"
      ],
      "completedRunRequiredRefs": [
        "sidecarBindingRef",
        "sidecarCapabilitiesRef",
        "sidecarDiscoveryRef",
        "schedulerLeaseRef",
        "schedulerLeaseRefs",
        "targetRefs",
        "replayRef",
        "validationRef",
        "currentBundleRef"
      ],
      "completedRunRequiredCapabilities": [
        "multi-screen",
        "multi-actor-cursor",
        "window-local-lease",
        "screen-global-lease",
        "refs-first-evidence",
        "image-evidence-replay",
        "independent-virtual-input-adapter"
      ],
      "commands": {
        "nativeM6OptIn": "npm run smoke:cu-native-m6:opt-in",
        "nativeM6OptInHelp": "npm run smoke:cu-native-m6:opt-in -- --help"
      },
      "claimLimit": "The native multi-screen live runner may use DOM/AX/Playwright refs only as grounding hints and is historical regression/diagnostic evidence only; it cannot set userAcceptanceEligible=true or satisfy Computer Use product acceptance."
    },
    "traceHandoff": {
      "schemaRef": "sciforge.computer-use.trace-handoff.v1",
      "presentationTarget": "computer-use.trace-summary",
      "approvalTarget": "computer-use.approval-request",
      "storagePolicy": "refs-first",
      "payloadPolicy": "refs-and-compact-summary-only",
      "forbiddenInlinePayloads": [
        "rawScreenshot",
        "base64",
        "data:image",
        "rawProviderPayload",
        "requestBody",
        "apiKey",
        "inlineImage"
      ]
    },
    "notes": "Computer Use action provider consumes host-owned platform ports. It never imports GUI implementation and never opens confirmation UI directly."
  },
  "publicSurfaceParity": {
    "schemaRef": "sciforge.computer-use.public-surface-parity.v1",
    "ownershipMapRef": "docs/native-extension-ownership-map.json#entries/computer-use",
    "requiredBacklogIds": [
      "CU-PKG-22-window-action-session-current-evidence-product-gate",
      "CU-PKG-23-multi-screen-live-demo",
      "CU-PKG-24-browser-runtime-dom-ax-observation-refs",
      "CU-PKG-25-native-multi-app-workflow-live-acceptance-matrix",
      "CU-PKG-26-public-surface-parity-guard"
    ],
    "requiredNativeSurfaces": [
      "WindowActionSession current evidence product gate",
      "computer-use-current-evidence-bundle manifest",
      "BrowserRuntime DOM/AX observation refs",
      "native multi-app workflow/live acceptance matrix",
      "native multi-screen/multi-actor cursor historical opt-in regression",
      "multi-screen live demo historical diagnostic"
    ],
    "nativeProductGatePolicy": {
      "activeGate": "window-action-session-current-evidence",
      "manifestName": "computer-use-current-evidence-bundle",
      "manifestSchemaRef": "sciforge.computer-use.current-evidence-bundle.v1",
      "productionHost": "Agent Host WindowActionSession via TypeScript host-port adapter",
      "requiredProvenance": [
        "taskId",
        "scenarioId",
        "userIntent",
        "currentBundleRef",
        "windowActionSessionRef",
        "hostPortsRef",
        "targetWindowRefs",
        "appStateRef",
        "screenshotRef",
        "focusCropRefs",
        "groundingRefs",
        "executorLeaseRefs",
        "executorEventRefs",
        "beforeAfterFrameRefs",
        "artifactRefs",
        "verificationRefs",
        "guiPresentRefs",
        "approvalRefs",
        "cancelRefs",
        "traceRefs",
        "replayRefs",
        "evidenceLedgerRef",
        "isolationFlags",
        "blockedReason"
      ],
      "requiredManifestFields": [
        "taskId",
        "scenarioId",
        "userIntent",
        "currentBundleRef",
        "windowActionSessionRef",
        "hostPortsRef",
        "targetWindowRefs",
        "executorEventRefs",
        "beforeAfterFrameRefs",
        "artifactRefs",
        "verificationRefs",
        "traceRefs",
        "evidenceLedgerRef",
        "isolationFlags",
        "blockedReason"
      ],
      "passStatePolicy": {
        "passedRequires": [
          "artifactRefs",
          "visible screenshot/frame refs",
          "action causality",
          "validator/verifier refs",
          "gui.present refs when presentation is requested",
          "replay refs",
          "isolation flags"
        ],
        "blockedStatuses": [
          "blocked",
          "needs-confirmation",
          "requires-handoff"
        ],
        "m6NativeMultiScreenUserLevelPassAllowed": false,
        "packageSmokeUserLevelPassAllowed": false
      },
      "historicalRegressionGateIds": [
        "legacy-compatibility-diagnostics",
        "m6-native-multi-screen",
        "multi-screen-live-demo"
      ],
      "forbiddenSubstituteGateIds": [
        "package-smoke",
        "m6-native-multi-screen",
        "target-bound-fixture",
        "historical-docker-novnc",
        "single-click-smoke",
        "dom",
        "playwright",
        "accessibility",
        "shell-direct-artifact",
        "old-trace",
        "gui-executor",
        "shared-system-input"
      ],
      "guiExecutionAllowed": false,
      "runtimeBridgePublicProductionApiAllowed": false,
      "workspaceGatewayProductionFallbackAllowed": false,
      "codexExecJsonProductionFallbackAllowed": false
    },
    "browserRuntimeObservationPolicy": {
      "allowedRefs": [
        "browserRuntimeDomSnapshotRef",
        "browserRuntimeVisibleDomRef",
        "browserRuntimeAccessibilitySnapshotRef",
        "browserRuntimePlaywrightEvaluateRef",
        "browserRuntimeStableTargetRef",
        "browserRuntimePageQueryRef",
        "browserRuntimeGroundingHintRef"
      ],
      "allowedUses": [
        "observe-before-mutate-hint",
        "grounding-hint"
      ],
      "forbiddenUses": [
        "Computer Use executor",
        "completion evidence by itself",
        "DOM click shortcut",
        "AX action shortcut",
        "Playwright action shortcut"
      ]
    },
    "legacyBackendPackaging": {
      "docker": "legacy diagnostic/backend packaging only",
      "noVNC": "legacy diagnostic viewer/backend readiness only",
      "rdp": "legacy or future sidecar backend packaging only",
      "activeProductGateEligible": false,
      "historicalEvidenceAllowedWhenRefsFirst": true
    },
    "claimLimit": "Computer Use is TS-only. WindowActionSession current evidence is the active product gate; removed legacy package routes, VirtualAppScreen, M6/native multi-screen, container viewers, remote desktop packaging, and retired desktop probes cannot satisfy product acceptance."
  },
  "plannerContract": {
    "schemaRef": "sciforge.computer-use.planner-action.v1",
    "inputs": [
      "task",
      "compactObservation",
      "visibleText",
      "recentActions",
      "verifierFeedback"
    ],
    "output": "exactly one generic action or done=true",
    "supportedActions": [
      "open_app",
      "click",
      "double_click",
      "drag",
      "type_text",
      "press_key",
      "hotkey",
      "scroll",
      "wait",
      "focus",
      "save"
    ],
    "rejectedIssues": [
      "coordinate-output",
      "app-private-shortcut",
      "unsupported-action",
      "empty-action"
    ],
    "coordinateOwner": "grounder-provider",
    "notes": "Planner must not output coordinates, app-private shortcuts, unsupported action types, or empty action blocks."
  },
  "traceContract": {
    "schemaRef": "sciforge.computer-use.loop-trace.v1",
    "storagePolicy": "ref-only",
    "eventTypes": [
      "observe",
      "plan",
      "ground",
      "execute",
      "verify",
      "complete",
      "fail"
    ],
    "redaction": [
      "typedText",
      "credentials",
      "privateWindowTitle",
      "rawScreenshot"
    ],
    "retention": "trace 只保存 refs、紧凑摘要和结构化步骤，大 payload 进入 artifact store。"
  },
  "verifierContract": {
    "required": true,
    "defaultVerifierTypes": [
      "environment",
      "human"
    ],
    "requiredWhen": [
      "riskLevel=high",
      "status=completed",
      "external side effect"
    ],
    "requestShape": {
      "goal": "ComputerUseRequest.task",
      "traceRefs": "computer-use trace refs",
      "stateRefs": "before/after observation refs",
      "riskLevel": "ActionPlan.risk_level"
    },
    "resultShape": {
      "verdict": "pass | fail | uncertain | needs-human | unverified",
      "reward": "number?",
      "confidence": "number",
      "critique": "string?",
      "repairHints": "string[]",
      "metadata": {
        "semanticVerifier": "refs-first optional summary",
        "endpointDiagnostics": "method/path/elapsed/retry/error-category only"
      }
    },
    "semanticVerifierPolicy": {
      "storagePolicy": "refs-first",
      "optional": true,
      "forbiddenInlinePayloads": [
        "apiKey",
        "rawProviderPayload",
        "requestBody",
        "inlineImage",
        "data:image",
        "base64"
      ],
      "fakeOrDiagnosticOnlyClaimLimit": "A fake provider or diagnostic-only semantic summary cannot own execution, coordinates, completion, or artifact-producing success."
    }
  },
  "failureModes": [
    {
      "code": "target-not-found",
      "stage": "targeting",
      "recoverable": true,
      "description": "sense provider 无法把动作目标定位到观察坐标。",
      "repairHints": [
        "重新观察目标窗口",
        "缩小目标区域",
        "请求更明确的目标描述"
      ]
    },
    {
      "code": "execution-blocked",
      "stage": "execution",
      "recoverable": true,
      "description": "host adapter 拒绝执行或目标环境不可用。",
      "repairHints": [
        "检查窗口绑定",
        "检查输入隔离",
        "切换到 dry-run 或请求用户介入"
      ]
    },
    {
      "code": "confirmation-required",
      "stage": "confirmation",
      "recoverable": true,
      "description": "动作风险等级需要显式确认。",
      "repairHints": [
        "请求 human approval",
        "降低动作风险或改为只观察"
      ]
    },
    {
      "code": "verification-failed",
      "stage": "verification",
      "recoverable": true,
      "description": "执行后验证未通过或不确定。",
      "repairHints": [
        "把 verification result 带入下一轮",
        "重新规划动作",
        "请求人类判断"
      ]
    },
    {
      "code": "semantic-provider-unavailable",
      "stage": "verification/provider-diagnostic",
      "recoverable": true,
      "description": "可选 semantic vision provider 不可用、超时、认证失败或 endpoint 诊断被阻断。",
      "repairHints": [
        "检查 ignored local visionLLM config",
        "查看 provider diagnostics 的 method/path/errorCategory",
        "保持 deterministic verifier 结果为主"
      ]
    }
  ]
}
