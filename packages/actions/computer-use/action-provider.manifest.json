{
  "schemaVersion": "sciforge.action-provider.manifest.v1",
  "id": "sciforge.computer-use",
  "version": "0.1.0",
  "kind": "action",
  "displayName": "SciForge Computer Use",
  "summary": "Refs-first Computer Use primitive action provider for target binding, observation, atomic GUI actions, local procedures, and session control.",
  "domains": [
    "gui",
    "automation",
    "workspace"
  ],
  "triggers": [
    "operate GUI",
    "click",
    "type",
    "scroll",
    "drag",
    "press key",
    "window-bound action",
    "local GUI procedure"
  ],
  "antiTriggers": [
    "vision-only question",
    "artifact rendering",
    "schema-only validation"
  ],
  "integrationLevel": "package-local-host-ports",
  "entrypoint": {
    "type": "typescript-package",
    "package": "@agi4sci/sciforge-computer-use-action-provider",
    "module": "packages/actions/computer-use/index.ts",
    "symbol": "createComputerUsePrimitiveService",
    "path": "packages/actions/computer-use",
    "interface": "createComputerUsePrimitiveService({ ports })",
    "productRoute": "Agent Host -> Computer Use primitive service -> host-provided target-bound ports -> current evidence bundle",
    "notes": "Computer Use product/default acceptance is TS-only. The primitive service owns schema validation and MCP-compatible dispatch; the Host owns task reasoning, approval collection, real ports, artifact validation, completion truth, and final answers."
  },
  "actionSchema": {
    "schemaRef": "sciforge.computer-use.primitive-input.v1",
    "inputShape": {
      "type": "object",
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "enum": [
            "sciforge.computer-use.bind-input.v1",
            "sciforge.computer-use.observe-input.v1",
            "sciforge.computer-use.act-input.v1",
            "sciforge.computer-use.run-procedure-input.v1",
            "sciforge.computer-use.control-input.v1"
          ]
        },
        "target": {
          "type": "object"
        },
        "sessionId": {
          "type": "string"
        },
        "actionId": {
          "type": "string"
        },
        "action": {
          "type": "object"
        },
        "captureAfter": {
          "type": "boolean"
        },
        "capture": {
          "enum": [
            "none",
            "screenshot",
            "accessibility",
            "both"
          ]
        },
        "includeTree": {
          "type": "boolean"
        },
        "risk": {
          "type": "object"
        },
        "riskPolicy": {
          "enum": [
            "fail-closed",
            "allow-confirmed"
          ]
        },
        "approvalRef": {
          "type": "string"
        },
        "procedureRef": {
          "type": "string"
        },
        "steps": {
          "type": "array"
        },
        "command": {
          "enum": [
            "pause",
            "resume",
            "cancel",
            "release",
            "stop"
          ]
        },
        "reasonRef": {
          "type": "string"
        },
        "budget": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "schemaVersion",
            "target"
          ],
          "properties": {
            "schemaVersion": {
              "const": "sciforge.computer-use.bind-input.v1"
            },
            "target": {
              "type": "object"
            },
            "riskPolicy": {
              "enum": [
                "fail-closed",
                "allow-confirmed"
              ]
            },
            "approvalRef": {
              "type": "string"
            },
            "budget": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "schemaVersion",
            "sessionId"
          ],
          "properties": {
            "schemaVersion": {
              "const": "sciforge.computer-use.observe-input.v1"
            },
            "sessionId": {
              "type": "string"
            },
            "capture": {
              "enum": [
                "none",
                "screenshot",
                "accessibility",
                "both"
              ]
            },
            "includeTree": {
              "type": "boolean"
            },
            "budget": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "schemaVersion",
            "sessionId",
            "action"
          ],
          "properties": {
            "schemaVersion": {
              "const": "sciforge.computer-use.act-input.v1"
            },
            "sessionId": {
              "type": "string"
            },
            "actionId": {
              "type": "string"
            },
            "action": {
              "type": "object",
              "required": [
                "type"
              ],
              "oneOf": [
                {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "click"
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "elementRef"
                      ]
                    },
                    {
                      "required": [
                        "point"
                      ]
                    }
                  ]
                },
                {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "double_click"
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "elementRef"
                      ]
                    },
                    {
                      "required": [
                        "point"
                      ]
                    }
                  ]
                },
                {
                  "required": [
                    "type",
                    "textRef"
                  ],
                  "properties": {
                    "type": {
                      "const": "type"
                    }
                  }
                },
                {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "key"
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "key"
                      ]
                    },
                    {
                      "required": [
                        "keys"
                      ]
                    }
                  ]
                },
                {
                  "required": [
                    "type",
                    "direction"
                  ],
                  "properties": {
                    "type": {
                      "const": "scroll"
                    }
                  }
                },
                {
                  "required": [
                    "type",
                    "durationMs"
                  ],
                  "properties": {
                    "type": {
                      "const": "wait"
                    }
                  }
                },
                {
                  "required": [
                    "type",
                    "command"
                  ],
                  "properties": {
                    "type": {
                      "const": "app_command"
                    }
                  }
                },
                {
                  "required": [
                    "type",
                    "point",
                    "toPoint"
                  ],
                  "properties": {
                    "type": {
                      "const": "drag"
                    }
                  }
                }
              ],
              "properties": {
                "type": {
                  "enum": [
                    "click",
                    "double_click",
                    "type",
                    "key",
                    "scroll",
                    "wait",
                    "app_command",
                    "drag"
                  ]
                },
                "elementRef": {
                  "type": "string"
                },
                "point": {
                  "type": "object"
                },
                "toPoint": {
                  "type": "object"
                },
                "textRef": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "keys": {
                  "type": "array"
                },
                "direction": {
                  "enum": [
                    "up",
                    "down",
                    "left",
                    "right"
                  ]
                },
                "amount": {
                  "type": "number"
                },
                "durationMs": {
                  "type": "number"
                },
                "command": {
                  "type": "string"
                }
              }
            },
            "captureAfter": {
              "type": "boolean"
            },
            "risk": {
              "type": "object"
            },
            "approvalRef": {
              "type": "string"
            },
            "budget": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "schemaVersion",
            "sessionId",
            "steps"
          ],
          "properties": {
            "schemaVersion": {
              "const": "sciforge.computer-use.run-procedure-input.v1"
            },
            "sessionId": {
              "type": "string"
            },
            "procedureRef": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "minItems": 1
            },
            "budget": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "schemaVersion",
            "sessionId",
            "command"
          ],
          "properties": {
            "schemaVersion": {
              "const": "sciforge.computer-use.control-input.v1"
            },
            "sessionId": {
              "type": "string"
            },
            "command": {
              "enum": [
                "pause",
                "resume",
                "cancel",
                "release",
                "stop"
              ]
            },
            "reasonRef": {
              "type": "string"
            },
            "budget": {
              "type": "object"
            }
          }
        }
      ]
    },
    "outputShape": {
      "type": "object",
      "required": [
        "schemaVersion",
        "moduleId",
        "primitive",
        "status",
        "refs",
        "diagnostics",
        "budget"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sciforge.computer-use.primitive-result.v1"
        },
        "moduleId": {
          "const": "computer_use"
        },
        "primitive": {
          "enum": [
            "bind",
            "observe",
            "act",
            "run_procedure",
            "control"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "blocked",
            "needs-confirmation",
            "failed"
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": true
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array"
        },
        "budget": {
          "type": "object"
        },
        "blockedReason": {
          "type": "string"
        },
        "repairHints": {
          "type": "array"
        }
      }
    },
    "examples": [
      {
        "schemaVersion": "sciforge.computer-use.bind-input.v1",
        "target": {
          "kind": "window",
          "windowRef": "window:macos/TextEdit/123"
        },
        "riskPolicy": "fail-closed"
      },
      {
        "schemaVersion": "sciforge.computer-use.act-input.v1",
        "sessionId": "cu-session-1",
        "actionId": "host-action-1",
        "action": {
          "type": "click",
          "elementRef": "element:save-button"
        },
        "captureAfter": true
      }
    ]
  },
  "environmentTargets": [
    {
      "type": "window",
      "coordinatePolicy": "window-bound",
      "sideEffects": [
        "pointer",
        "keyboard",
        "focused-window-state"
      ],
      "isolation": "观察、坐标映射和执行都必须绑定目标窗口或窗口内容坐标。"
    },
    {
      "type": "remote-desktop",
      "coordinatePolicy": "provider-defined",
      "sideEffects": [
        "remote-pointer",
        "remote-keyboard"
      ],
      "isolation": "远程会话必须隔离输入通道和 trace。"
    }
  ],
  "safetyGates": {
    "riskClass": "high",
    "defaultPolicy": "fail-closed",
    "highRiskPolicy": "fail-closed",
    "supportsDryRun": true,
    "blockedActions": [
      "payment",
      "credential-change",
      "destructive-delete",
      "external-send-without-approval"
    ],
    "requiresExplicitTarget": true,
    "notes": "High-risk computer_use.act returns needs-confirmation unless the caller supplies an approvalRef bound to the same risk envelope."
  },
  "confirmationRules": {
    "requiredWhen": [
      "riskLevel=high",
      "external side effect",
      "destructive action",
      "approvalPolicy missing"
    ],
    "approvalEvidence": [
      "ComputerUseActInput.approvalRef",
      "ComputerUseBindInput.approvalRef for target binding policies",
      "caller-owned approval sidecar refs"
    ],
    "timeoutPolicy": "fail"
  },
  "hostPortsContract": {
    "schemaRef": "sciforge.computer-use.host-ports.v1",
    "policySource": "packages/actions/computer-use/index.ts",
    "requiredPorts": [
      "bind",
      "observe",
      "act",
      "control"
    ],
    "optionalPorts": [
      "runProcedure",
      "writeTrace",
      "emitEvent"
    ],
    "realDesktopEvidenceRequiredPorts": [
      "bind",
      "observe",
      "act",
      "control",
      "writeTrace",
      "emitEvent"
    ],
    "forbiddenPorts": [
      "requestApproval",
      "gui.present",
      "gui.ask_user"
    ],
    "providerIdPolicy": {
      "bind": [
        "target-window-session-binder",
        "app-window-session-binder",
        "remote-desktop-session-binder"
      ],
      "observe": [
        "target-window-observation-provider",
        "accessibility-observation-provider",
        "screenshot-ref-observation-provider"
      ],
      "act": [
        "dry-run-generic-gui-executor",
        "target-bound-scoped-input-provider",
        "package-target-bound-window-executor",
        "<desktopPlatform>-generic-gui-executor"
      ],
      "runProcedure": "local-primitive-procedure-runner",
      "control": "target-bound-session-control",
      "writeTrace": "workspace-file-ref-trace-writer",
      "emitEvent": "workspace-runtime-events"
    },
    "executorAdapterContract": {
      "schemaRef": "sciforge.computer-use.virtual-input-adapter-manifest.v1",
      "requiredStatus": "independent-simulated-input-adapter",
      "requiredSideEffects": {
        "realOsInput": false,
        "sharedSystemInput": false,
        "systemPointerMove": false,
        "systemKeyboardEvent": false
      },
      "stateRefs": [
        "virtualInputStateRef",
        "virtualPointerStateRef",
        "virtualKeyboardStateRef",
        "targetPointerStateRef",
        "targetKeyboardStateRef",
        "targetInputEventLogRef"
      ],
      "bindingManifestSchema": "sciforge.computer-use.input-adapter-target-binding.v1",
      "adapterManifestValidationSchema": "sciforge.computer-use.input-adapter-manifest-validation.v1",
      "bindingValidationSchema": "sciforge.computer-use.input-adapter-target-binding-validation.v1",
      "bindingRequiredRefs": [
        "adapterManifestRef",
        "targetWindowRef",
        "evidenceRefs"
      ],
      "bindingClaimLimit": "Target binding validation is required for real desktop preflight readiness, but is not B/C/verifier completion evidence.",
      "targetBindingRequiredForRealDesktopEvidence": true,
      "readyInputChannels": [
        "isolated-window",
        "target-bound-simulated-input",
        "independent-simulated-input-adapter",
        "remote-desktop-isolated-session"
      ],
      "diagnosticExecutorProvidersBlockedForReady": [
        "native-stdio-fail-closed-executor",
        "fail-closed-executor",
        "diagnostic-fail-closed-executor",
        "virtual-input-state-executor"
      ],
      "shortcutExecutorProvidersBlockedForReady": [
        "shell-direct-file-write",
        "accessibility-tree",
        "ax",
        "applescript",
        "dom",
        "playwright",
        "private-api",
        "clipboard"
      ],
      "diagnosticOnlyUntilHostBound": true
    },
    "stdioProtocol": {
      "callSchema": "sciforge.computer-use.host-port-call.v1",
      "resultSchema": "sciforge.computer-use.host-port-result.v1",
      "finalResultSchema": "sciforge.computer-use.cli-final-result.v1"
    },
    "nativeMultiScreenSidecarProtocol": {
      "callSchema": "sciforge.computer-use.native-sidecar-dispatch-call.v1",
      "resultSchema": "sciforge.computer-use.platform-sidecar-result.v1",
      "requiredDiscoveryTools": [
        "capabilities",
        "discover"
      ],
      "requiredExecutionTools": [
        "preflight",
        "capture",
        "state",
        "execute"
      ],
      "completedRunRequiredRefs": [
        "sidecarBindingRef",
        "sidecarCapabilitiesRef",
        "sidecarDiscoveryRef",
        "schedulerLeaseRef",
        "schedulerLeaseRefs",
        "targetRefs",
        "replayRef",
        "validationRef",
        "currentBundleRef"
      ],
      "completedRunRequiredCapabilities": [
        "multi-screen",
        "multi-actor-cursor",
        "window-local-lease",
        "screen-global-lease",
        "refs-first-evidence",
        "image-evidence-replay",
        "independent-virtual-input-adapter"
      ],
      "commands": {
        "nativeM6OptIn": "npm run smoke:cu-native-m6:opt-in",
        "nativeM6OptInHelp": "npm run smoke:cu-native-m6:opt-in -- --help"
      },
      "claimLimit": "The native multi-screen live runner may use DOM/AX/Playwright refs only as grounding hints and is historical regression/diagnostic evidence only; it cannot set userAcceptanceEligible=true or satisfy Computer Use product acceptance."
    },
    "traceHandoff": {
      "schemaRef": "sciforge.computer-use.trace-handoff.v1",
      "presentationTarget": "computer-use.trace-summary",
      "approvalTarget": "computer-use.approval-request",
      "storagePolicy": "refs-first",
      "payloadPolicy": "refs-and-compact-summary-only",
      "forbiddenInlinePayloads": [
        "rawScreenshot",
        "base64",
        "data:image",
        "rawProviderPayload",
        "requestBody",
        "apiKey",
        "inlineImage"
      ]
    },
    "notes": "Computer Use action provider consumes host-owned platform ports. It never imports GUI implementation and never opens confirmation UI directly."
  },
  "publicSurfaceParity": {
    "schemaRef": "sciforge.computer-use.public-surface-parity.v1",
    "ownershipMapRef": "docs/native-extension-ownership-map.json#entries/computer-use",
    "requiredBacklogIds": [
      "CU-PKG-22-window-action-session-current-evidence-product-gate",
      "CU-PKG-23-multi-screen-live-demo",
      "CU-PKG-24-browser-runtime-dom-ax-observation-refs",
      "CU-PKG-25-native-multi-app-workflow-live-acceptance-matrix",
      "CU-PKG-26-public-surface-parity-guard"
    ],
    "requiredNativeSurfaces": [
      "WindowActionSession current evidence product gate",
      "computer-use-current-evidence-bundle manifest",
      "BrowserRuntime DOM/AX observation refs",
      "native multi-app workflow/live acceptance matrix",
      "native multi-screen/multi-actor cursor historical opt-in regression",
      "multi-screen live demo historical diagnostic"
    ],
    "nativeProductGatePolicy": {
      "activeGate": "window-action-session-current-evidence",
      "manifestName": "computer-use-current-evidence-bundle",
      "manifestSchemaRef": "sciforge.computer-use.current-evidence-bundle.v1",
      "productionHost": "Agent Host WindowActionSession via TypeScript host-port adapter",
      "requiredProvenance": [
        "taskId",
        "scenarioId",
        "userIntent",
        "currentBundleRef",
        "windowActionSessionRef",
        "hostPortsRef",
        "targetWindowRefs",
        "appStateRef",
        "screenshotRef",
        "focusCropRefs",
        "groundingRefs",
        "executorLeaseRefs",
        "executorEventRefs",
        "beforeAfterFrameRefs",
        "artifactRefs",
        "verificationRefs",
        "guiPresentRefs",
        "approvalRefs",
        "cancelRefs",
        "traceRefs",
        "replayRefs",
        "evidenceLedgerRef",
        "isolationFlags",
        "blockedReason"
      ],
      "requiredManifestFields": [
        "taskId",
        "scenarioId",
        "userIntent",
        "currentBundleRef",
        "windowActionSessionRef",
        "hostPortsRef",
        "targetWindowRefs",
        "executorEventRefs",
        "beforeAfterFrameRefs",
        "artifactRefs",
        "verificationRefs",
        "traceRefs",
        "evidenceLedgerRef",
        "isolationFlags",
        "blockedReason"
      ],
      "passStatePolicy": {
        "passedRequires": [
          "artifactRefs",
          "visible screenshot/frame refs",
          "action causality",
          "validator/verifier refs",
          "gui.present refs when presentation is requested",
          "replay refs",
          "isolation flags"
        ],
        "blockedStatuses": [
          "blocked",
          "needs-confirmation",
          "requires-handoff"
        ],
        "m6NativeMultiScreenUserLevelPassAllowed": false,
        "packageSmokeUserLevelPassAllowed": false
      },
      "historicalRegressionGateIds": [
        "legacy-compatibility-diagnostics",
        "m6-native-multi-screen",
        "multi-screen-live-demo"
      ],
      "forbiddenSubstituteGateIds": [
        "package-smoke",
        "m6-native-multi-screen",
        "target-bound-fixture",
        "historical-docker-novnc",
        "single-click-smoke",
        "dom",
        "playwright",
        "accessibility",
        "shell-direct-artifact",
        "old-trace",
        "gui-executor",
        "shared-system-input"
      ],
      "guiExecutionAllowed": false,
      "runtimeBridgePublicProductionApiAllowed": false,
      "workspaceGatewayProductionFallbackAllowed": false,
      "codexExecJsonProductionFallbackAllowed": false
    },
    "browserRuntimeObservationPolicy": {
      "allowedRefs": [
        "browserRuntimeDomSnapshotRef",
        "browserRuntimeVisibleDomRef",
        "browserRuntimeAccessibilitySnapshotRef",
        "browserRuntimePlaywrightEvaluateRef",
        "browserRuntimeStableTargetRef",
        "browserRuntimePageQueryRef",
        "browserRuntimeGroundingHintRef"
      ],
      "allowedUses": [
        "observe-before-mutate-hint",
        "grounding-hint"
      ],
      "forbiddenUses": [
        "Computer Use executor",
        "completion evidence by itself",
        "DOM click shortcut",
        "AX action shortcut",
        "Playwright action shortcut"
      ]
    },
    "legacyBackendPackaging": {
      "docker": "legacy diagnostic/backend packaging only",
      "noVNC": "legacy diagnostic viewer/backend readiness only",
      "rdp": "legacy or future sidecar backend packaging only",
      "activeProductGateEligible": false,
      "historicalEvidenceAllowedWhenRefsFirst": true
    },
    "claimLimit": "Computer Use is TS-only. WindowActionSession current evidence is the active product gate; removed legacy package routes, VirtualAppScreen, M6/native multi-screen, container viewers, remote desktop packaging, and retired desktop probes cannot satisfy product acceptance."
  },
  "traceContract": {
    "schemaRef": "sciforge.computer-use.primitive-trace.v1",
    "storagePolicy": "ref-only",
    "eventTypes": [
      "bind",
      "observe",
      "act",
      "run_procedure",
      "control",
      "needs-confirmation",
      "blocked",
      "failed"
    ],
    "redaction": [
      "rawText",
      "credentials",
      "privateWindowTitle",
      "rawScreenshot",
      "rawAccessibilityTree",
      "rawProviderPayload",
      "base64",
      "data:image"
    ],
    "retention": "Primitive trace only stores refs, compact diagnostics, structured step records, and invalidation refs. Raw screenshots, raw AX trees, raw provider payloads, and typed text stay outside the public primitive body."
  },
  "verifierContract": {
    "required": false,
    "defaultVerifierTypes": [
      "environment",
      "human"
    ],
    "requiredWhen": [
      "caller needs user-level completion truth",
      "caller needs artifact validation",
      "caller needs high-risk approval decision"
    ],
    "requestShape": {
      "callerGoalRef": "owned by caller",
      "primitiveRefs": "bind/observe/act/run_procedure/control refs",
      "beforeAfterObservationRefs": "optional GUI evidence refs from primitives",
      "artifactRefs": "owned by caller or artifact validator",
      "riskEnvelopeRefs": "caller approval/verifier inputs"
    },
    "resultShape": {
      "verdictRef": "owned by caller/verifier",
      "artifactValidationRefs": "owned by artifact validator",
      "repairHints": "caller-owned structured hints",
      "completionTruth": "not produced by Computer Use primitives"
    }
  },
  "failureModes": [
    {
      "code": "target-binding-blocked",
      "stage": "targeting",
      "recoverable": true,
      "description": "Host 指定 target 无法绑定为 scoped Computer Use session。",
      "repairHints": [
        "重新选择 target ref",
        "确认目标窗口、应用、显示器或远程会话仍然存在",
        "重新调用 computer_use.bind"
      ]
    },
    {
      "code": "missing-host-port",
