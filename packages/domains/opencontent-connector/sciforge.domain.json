{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-opencontent-connector",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.opencontent-connector",
    "displayName": "OpenContent Connector",
    "version": "4.0.4",
    "hostApi": {
      "minimum": "1.9.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 280
  },
  "contributionContracts": {
    "opencontent-connector.provider-instance": {
      "location": "main.provider-instance-directory-entry",
      "contractVersion": "1.0.0",
      "providerInstanceRef": "opencontent-edoc2-demo",
      "providerKind": "opencontent",
      "displayName": "OpenContent"
    },
    "opencontent-connector.content-space-service": {
      "location": "main.internal-service-descriptor",
      "serviceId": "opencontent.content-space",
      "contractVersion": "4.0.0",
      "allowedConsumerModuleIds": [
        "sciforge.opencontent-content-space-provider"
      ]
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "id": "opencontent-connector.capabilities",
          "kind": "main.capability-factory",
          "priority": 280
        },
        {
          "id": "opencontent-connector.provider-instance",
          "kind": "main.extension",
          "version": "1.0.0",
          "priority": 280
        },
        {
          "id": "opencontent-connector.content-space-service",
          "kind": "main.extension",
          "version": "4.0.0",
          "priority": 280
        }
      ]
    }
  ]
}
