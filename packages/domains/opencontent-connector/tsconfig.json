{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@sciforge/domain-sdk": ["../../domain-sdk/src/index.ts"],
      "@sciforge/domain-sdk/*": ["../../domain-sdk/src/*"]
    },
    "types": ["node", "react", "react-dom"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
