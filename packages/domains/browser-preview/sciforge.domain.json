{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-browser-preview",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.browser-preview",
    "displayName": "Browser Preview",
    "version": "1.0.8",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 110
  },
  "contributionContracts": {
    "browser-preview.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Native browser",
      "titleKey": "common:browserPreviewTitle",
      "resourceKind": "browser-page"
    },
    "browser-preview.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "browser-preview.open",
      "label": "browserPreviewRightPanelBrowser"
    },
    "browser-preview.url-context": {
      "location": "composer.context",
      "label": "Browser URL context"
    },
    "browser-preview.visual-source": {
      "contractVersion": 1,
      "id": "browser-preview.visual-source",
      "resourceKinds": [
        "browser-page"
      ]
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "browser-preview.capabilities"
        },
        {
          "kind": "main.visual-source",
          "id": "browser-preview.visual-source"
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.workbench-right-panel",
          "id": "browser-preview.workbench-right-panel"
        },
        {
          "kind": "renderer.command",
          "id": "browser-preview.open"
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "browser-preview.workbench-toolbar-action"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "browser-preview.translations"
        },
        {
          "kind": "renderer.composer-context-provider",
          "id": "browser-preview.url-context"
        }
      ]
    }
  ]
}
