{
  "name": "@sciforge/domain-siyuan-content-space-provider",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "SiYuan server-mode Content Space provider with an embedded native editor.",
  "exports": {
    "./definition": "./src/definition.ts",
    "./main": "./src/main/index.ts",
    "./client": "./src/main/client.ts",
    "./smoke": "./src/main/smoke.ts",
    "./renderer": "./src/renderer/index.tsx"
  },
  "files": [
    "src",
    "scripts",
    "sciforge.domain.json",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "smoke": "node --env-file-if-exists=../../../.env.siyuan --import tsx scripts/smoke.ts",
    "editor:smoke": "node --env-file-if-exists=../../../.env.siyuan scripts/editor-smoke.mjs"
  },
  "dependencies": {
    "@sciforge/domain-content-space": "5.0.4",
    "@sciforge/domain-sdk": "^0.2.13",
    "zod": "^4.4.3",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^4.1.7",
    "@types/react": "^19.0.0",
    "playwright-core": "^1.61.1"
  }
}