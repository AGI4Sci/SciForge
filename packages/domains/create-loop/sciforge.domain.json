{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-create-loop",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.create-loop",
    "displayName": "Create Loop",
    "version": "1.0.0",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 120
  },
  "contributionContracts": {
    "create-loop.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Create Loop",
      "resourceKind": "create-loop-settings"
    },
    "create-loop.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "create-loop.open",
      "label": "workflowAutomationToolbar"
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "create-loop.capabilities"
        },
        {
          "kind": "main.runtime-lifecycle",
          "id": "create-loop.runtime-lifecycle"
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.command",
          "id": "create-loop.open"
        },
        {
          "kind": "renderer.workbench-right-panel",
          "id": "create-loop.workbench-right-panel"
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "create-loop.workbench-toolbar-action"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "create-loop.translations"
        }
      ]
    }
  ]
}
