{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-collaboration",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.collaboration",
    "displayName": "Collaboration",
    "version": "2.0.1",
    "hostApi": {
      "minimum": "1.5.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 72
  },
  "contributionContracts": {
    "collaboration.coordinator-cloud-command": {
      "location": "main.internal-service-descriptor",
      "serviceId": "sciforge.collaboration.coordinator-cloud-command",
      "contractVersion": "1.0.0",
      "allowedConsumerModuleIds": [
        "sciforge.project-coordinator"
      ]
    },
    "collaboration.runtime-lifecycle": {
      "requestedSystemCapabilityGrants": [
        "content-space.system-transfer"
      ]
    },
    "collaboration.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Collaboration",
      "resourceKind": "collaboration"
    },
    "collaboration.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "collaboration.open",
      "label": "collaborationToolbar"
    }
  },
  "packaging": {
    "bundled": true,
    "runtime": {
      "requiredPaths": [],
      "dependencies": []
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "collaboration.capabilities"
        },
        {
          "kind": "main.runtime-lifecycle",
          "id": "collaboration.runtime-lifecycle"
        },
        {
          "kind": "main.extension",
          "id": "collaboration.coordinator-cloud-command",
          "version": "1.0.0",
          "priority": 72
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.workbench-right-panel",
          "id": "collaboration.workbench-right-panel"
        },
        {
          "kind": "renderer.command",
          "id": "collaboration.open"
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "collaboration.workbench-toolbar-action"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "collaboration.translations"
        }
      ]
    }
  ]
}
