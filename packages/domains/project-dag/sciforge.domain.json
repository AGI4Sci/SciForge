{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-project-dag",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.project-dag",
    "displayName": "Project DAG",
    "version": "1.0.4",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 90
  },
  "packaging": {
    "bundled": true,
    "runtime": {
      "requiredPaths": [
        "pyproject.toml",
        "python/project_dag/__init__.py",
        "python/project_dag/server.py",
        "ui/index.html"
      ],
      "dependencies": [
        "@sciforge/domain-evidence-dag"
      ]
    }
  },
  "contributionContracts": {
    "project-dag.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Project DAG",
      "resourceKind": "project-dag"
    },
    "project-dag.research-summary": {
      "slot": "goal",
      "label": "Goal and scope",
      "order": 10,
      "scopeKinds": ["workspace"],
      "resourceKinds": ["project-dag", "project-goal", "project-snapshot"]
    },
    "project-dag.resource-navigation": {
      "resourceKinds": ["project-dag", "project-goal", "project-snapshot"],
      "target": {
        "surface": "right-panel",
        "contributionId": "project-dag.workbench-right-panel"
      }
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "project-dag.capabilities"
        },
        {
          "kind": "main.runtime-lifecycle",
          "id": "project-dag.runtime-lifecycle"
        },
        {
          "kind": "main.artifact-consumer",
          "id": "project-dag.artifacts"
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.workbench-right-panel",
          "id": "project-dag.workbench-right-panel"
        },
        {
          "kind": "renderer.research-summary.v1",
          "id": "project-dag.research-summary"
        },
        {
          "kind": "renderer.resource-navigation",
          "id": "project-dag.resource-navigation"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "project-dag.translations"
        }
      ]
    }
  ]
}
