{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-paper-radar",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.paper-radar",
    "displayName": "Paper Radar",
    "version": "1.0.1",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 100
  },
  "contributionContracts": {
    "paper-radar.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Paper radar",
      "resourceKind": "paper-radar"
    },
    "paper-radar.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "paper-radar.open",
      "label": "rightPanelPaperRadar"
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        { "kind": "main.capability-factory", "id": "paper-radar.capabilities" }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        { "kind": "renderer.workbench-right-panel", "id": "paper-radar.workbench-right-panel" },
        { "kind": "renderer.command", "id": "paper-radar.open" },
        { "kind": "renderer.workbench-toolbar-action", "id": "paper-radar.workbench-toolbar-action" },
        { "kind": "renderer.i18n-resource", "id": "paper-radar.translations" }
      ]
    }
  ]
}
