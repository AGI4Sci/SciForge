{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-terminal",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.terminal",
    "displayName": "Terminal",
    "version": "1.0.1",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 120
  },
  "contributionContracts": {
    "terminal.workbench-bottom-panel": {
      "location": "workbench.bottom-panel",
      "title": "Terminal",
      "resourceKind": "host.controlled-process"
    },
    "terminal.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "terminal.open",
      "label": "rightPanelTerminal"
    }
  },
  "entrypoints": [
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.command",
          "id": "terminal.open"
        },
        {
          "kind": "renderer.workbench-bottom-panel",
          "id": "terminal.workbench-bottom-panel"
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "terminal.workbench-toolbar-action"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "terminal.translations"
        },
        {
          "kind": "renderer.lifecycle",
          "id": "terminal.renderer-lifecycle"
        }
      ]
    }
  ]
}
