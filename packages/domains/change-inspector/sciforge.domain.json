{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-change-inspector",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.change-inspector",
    "displayName": "Change Inspector",
    "version": "1.0.0",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 122
  },
  "contributionContracts": {
    "change-inspector.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Change Inspector",
      "resourceKind": "agent-session-changes"
    },
    "change-inspector.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "change-inspector.open",
      "label": "changeInspectorToolbar"
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "change-inspector.capabilities"
        },
        {
          "kind": "main.runtime-lifecycle",
          "id": "change-inspector.runtime-lifecycle"
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.command",
          "id": "change-inspector.open"
        },
        {
          "kind": "renderer.workbench-right-panel",
          "id": "change-inspector.workbench-right-panel"
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "change-inspector.workbench-toolbar-action"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "change-inspector.translations"
        }
      ]
    }
  ]
}
