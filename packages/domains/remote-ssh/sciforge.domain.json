{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-remote-ssh",
  "module": {
    "id": "sciforge.remote-ssh",
    "displayName": "Remote SSH",
    "version": "1.0.0",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 100
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        { "kind": "main.capability-factory", "id": "remote-ssh.capabilities" }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        { "kind": "renderer.workbench-right-panel", "id": "remote-ssh.workbench-right-panel" },
        { "kind": "renderer.i18n-resource", "id": "remote-ssh.translations" }
      ]
    }
  ]
}
