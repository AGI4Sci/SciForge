{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-remote-ssh",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.remote-ssh",
    "displayName": "Remote SSH",
    "version": "1.0.0",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 100
  },
  "contributionContracts": {
    "remote-ssh.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "remote-ssh.open",
      "label": "rightPanelRemoteSsh",
      "target": {
        "kind": "workbench.right-panel",
        "contributionId": "remote-ssh.workbench-right-panel"
      }
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        { "kind": "main.capability-factory", "id": "remote-ssh.capabilities" }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        { "kind": "renderer.workbench-right-panel", "id": "remote-ssh.workbench-right-panel" },
        { "kind": "renderer.workbench-toolbar-action", "id": "remote-ssh.workbench-toolbar-action" },
        { "kind": "renderer.i18n-resource", "id": "remote-ssh.translations" }
      ]
    }
  ]
}
