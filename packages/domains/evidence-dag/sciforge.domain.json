{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-evidence-dag",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.evidence-dag",
    "displayName": "Evidence DAG",
    "version": "2.13.0",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 160
  },
  "packaging": {
    "bundled": true,
    "runtime": {
      "requiredPaths": [
        "pyproject.toml",
        "python/evidence_dag/__init__.py",
        "python/evidence_dag/artifact_versions.py",
        "python/evidence_dag/digraph.py",
        "python/evidence_dag/products.py",
        "python/evidence_dag/server.py",
        "ui/index.html"
      ]
    }
  },
  "contributionContracts": {
    "evidence-dag.research-record-overlay": {
      "location": "workbench.global-overlay",
      "title": "科研审计",
      "resourceKind": "research-record"
    },
    "evidence-dag.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Evidence DAG",
      "titleKey": "common:rightPanelEvidenceDag",
      "resourceKind": "evidence-dag",
      "navigation": "resource-only"
    },
    "evidence-dag.research-summary": {
      "slot": "status",
      "label": "Evidence",
      "order": 30,
      "scopeKinds": [
        "workspace"
      ],
      "resourceKinds": [
        "evidence-dag",
        "evidence-claim",
        "evidence-closure"
      ]
    },
    "evidence-dag.resource-navigation": {
      "resourceKinds": [
        "evidence-dag",
        "evidence-claim",
        "evidence-closure",
        "evidence-snapshot"
      ],
      "target": {
        "surface": "right-panel",
        "contributionId": "evidence-dag.workbench-right-panel"
      }
    },
    "evidence-dag.capability-eval": {
      "contractVersion": 1,
      "kind": "capability-evaluation",
      "actionSource": "packages/domains/evidence-dag/src/contract.ts"
    },
    "evidence-dag.research-workspace": {
      "location": "research.workspace",
      "order": 0
    },
    "evidence-dag.audit-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "evidence-dag.open-audit",
      "label": "researchAuditOpen"
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "evidence-dag.capabilities",
          "priority": 160
        },
        {
          "kind": "main.runtime-lifecycle",
          "id": "evidence-dag.runtime-lifecycle",
          "priority": 160
        },
        {
          "kind": "main.artifact-consumer",
          "id": "evidence-dag.artifact-consumer",
          "priority": 160
        },
        {
          "kind": "main.action-guard",
          "id": "evidence-dag.write-export-guard",
          "priority": 160
        },
        {
          "kind": "main.capability-eval",
          "id": "evidence-dag.capability-eval",
          "priority": 160
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.workbench-global-overlay",
          "id": "evidence-dag.research-record-overlay",
          "priority": 160
        },
        {
          "kind": "renderer.workbench-right-panel",
          "id": "evidence-dag.workbench-right-panel",
          "priority": 160
        },
        {
          "kind": "renderer.research-summary.v1",
          "id": "evidence-dag.research-summary",
          "priority": 160
        },
        {
          "kind": "renderer.resource-navigation",
          "id": "evidence-dag.resource-navigation",
          "priority": 160
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "evidence-dag.translations",
          "priority": 160
        },
        {
          "kind": "renderer.extension",
          "id": "evidence-dag.research-workspace",
          "priority": 160
        },
        {
          "kind": "renderer.command",
          "id": "evidence-dag.open-audit",
          "priority": 161
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "evidence-dag.audit-toolbar-action",
          "priority": 161
        }
      ]
    }
  ]
}
