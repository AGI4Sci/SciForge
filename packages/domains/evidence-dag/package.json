{
  "name": "@sciforge/domain-evidence-dag",
  "version": "1.1.5",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "description": "Installed Evidence DAG domain package for SciForge.",
  "exports": {
    "./contract": "./src/contract.ts",
    "./storage": "./src/storage.ts",
    "./producer-inbox": "./src/producer-inbox.ts",
    "./host-services": "./src/host-services.ts",
    "./host/committed-reader": "./src/host/committed-reader.ts",
    "./host/host-provider": "./src/host/host-provider.ts",
    "./host/ports": "./src/host/ports.ts",
    "./host/production-service": "./src/host/production-service.ts",
    "./host/python-worker": "./src/host/python-worker.ts",
    "./host/quiescence": "./src/host/quiescence.ts",
    "./definition": "./src/definition.ts",
    "./main": "./src/main.ts",
    "./renderer": "./src/renderer/index.tsx"
  },
  "files": [
    "src",
    "scripts/python.mjs",
    "eval-cases",
    "python/**/*.py",
    "samples",
    "ui",
    ".env.example",
    "pyproject.toml",
    "requirements.txt",
    "sciforge.domain.json",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "start": "node scripts/python.mjs -m evidence_dag.server",
    "serve": "npm run start",
    "samples": "node scripts/python.mjs samples/load.py",
    "python:test": "node scripts/python.mjs -m unittest discover -s tests -v",
    "desktop:test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run desktop:test && npm run python:test"
  },
  "engines": {
    "python": ">=3.10"
  },
  "dependencies": {
    "@sciforge/domain-artifact-versions": "^1.1.0",
    "@sciforge/domain-sdk": "^0.2.18",
    "@sciforge/plugin-sdk": "^0.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-i18next": "^15.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.10",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2"
  }
}
