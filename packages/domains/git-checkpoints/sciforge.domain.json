{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-git-checkpoints",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.git-checkpoints",
    "displayName": "Git Checkpoints",
    "version": "1.0.2",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 120
  },
  "contributionContracts": {
    "git-checkpoints.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "Git Checkpoints",
      "resourceKind": "git-checkpoint"
    },
    "git-checkpoints.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "git-checkpoints.open",
      "label": "gitCheckpointsToolbar",
      "group": {
        "id": "workbench.history",
        "label": "workbenchToolGroupHistory"
      }
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "git-checkpoints.capabilities",
          "priority": 120
        },
        {
          "kind": "main.runtime-lifecycle",
          "id": "git-checkpoints.runtime-lifecycle",
          "priority": 120
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.workbench-right-panel",
          "id": "git-checkpoints.workbench-right-panel",
          "priority": 120
        },
        {
          "kind": "renderer.command",
          "id": "git-checkpoints.open",
          "priority": 120
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "git-checkpoints.workbench-toolbar-action",
          "priority": 120
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "git-checkpoints.translations",
          "priority": 120
        }
      ]
    }
  ]
}
