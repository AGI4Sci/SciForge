{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-visual-review",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.visual-review",
    "displayName": "Visual Review",
    "version": "1.0.0",
    "hostApi": {
      "minimum": "1.0.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 150
  },
  "contributionContracts": {
    "visual-review.workbench-right-panel": {
      "location": "workbench.right-panel",
      "title": "visualReviewPanelTitle",
      "resourceKind": "visual-review-document"
    },
    "visual-review.workbench-toolbar-action": {
      "location": "workbench.topbar",
      "commandId": "visual-review.open",
      "label": "rightPanelVisualReview"
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "visual-review.capabilities"
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.workbench-right-panel",
          "id": "visual-review.workbench-right-panel"
        },
        {
          "kind": "renderer.command",
          "id": "visual-review.open"
        },
        {
          "kind": "renderer.workbench-toolbar-action",
          "id": "visual-review.workbench-toolbar-action"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "visual-review.translations"
        }
      ]
    }
  ]
}
