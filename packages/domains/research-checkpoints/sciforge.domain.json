{
  "contractVersion": 1,
  "kind": "trusted-compile-time",
  "packageName": "@sciforge/domain-research-checkpoints",
  "publisher": {
    "id": "sciforge",
    "displayName": "SciForge"
  },
  "module": {
    "id": "sciforge.research-checkpoints",
    "displayName": "Research Checkpoints",
    "version": "1.0.2",
    "hostApi": {
      "minimum": "1.1.0",
      "maximumExclusive": "2.0.0"
    },
    "priority": 86
  },
  "contributionContracts": {
    "research-checkpoints.runtime-lifecycle": {
      "requestedSystemCapabilityGrants": [
        "artifact-versions.identities.select"
      ]
    }
  },
  "entrypoints": [
    {
      "process": "main",
      "export": "./main",
      "contributions": [
        {
          "kind": "main.capability-factory",
          "id": "research-checkpoints.capabilities"
        },
        {
          "kind": "main.runtime-lifecycle",
          "id": "research-checkpoints.runtime-lifecycle"
        },
        {
          "kind": "main.artifact-consumer",
          "id": "research-checkpoints.artifacts"
        }
      ]
    },
    {
      "process": "renderer",
      "export": "./renderer",
      "contributions": [
        {
          "kind": "renderer.chat-result-panel",
          "id": "research-checkpoints.timeline-status"
        },
        {
          "kind": "renderer.i18n-resource",
          "id": "research-checkpoints.translations"
        }
      ]
    }
  ]
}
