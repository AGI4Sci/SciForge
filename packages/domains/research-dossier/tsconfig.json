{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@sciforge/domain-sdk/*": ["../../domain-sdk/src/*"],
      "@sciforge/domain-artifact-versions/contract": ["../artifact-versions/src/contract.ts"],
      "@sciforge/domain-research-checkpoints/contract": ["../research-checkpoints/src/contract.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
