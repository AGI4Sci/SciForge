{
  "name": "@sciforge-observe/web",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "SciForge read-only web observe capability contracts.",
  "sciforge": {
    "lifecycleLayer": "observe",
    "skillFacing": false,
    "sideEffects": "network",
    "publicContract": true,
    "runtimeAdapter": false
  },
  "exports": {
    ".": "./manifest.ts",
    "./manifest": "./manifest.ts",
    "./web_search": "./capabilities/web_search.manifest.json",
    "./web_fetch": "./capabilities/web_fetch.manifest.json",
    "./browser_search": "./capabilities/browser_search.manifest.json",
    "./browser_fetch": "./capabilities/browser_fetch.manifest.json",
    "./browser_runtime": "./capabilities/browser_runtime.manifest.json",
    "./browser-runtime": "./browser-runtime.ts",
    "./playwright_browser_automation": "./capabilities/playwright_browser_automation.manifest.json",
    "./mcp/playwright-browser": "./mcp/playwright-browser.ts",
    "./mcp/playwright-browser-provider": "./mcp/playwright-browser-provider.ts",
    "./playwright_edge_browser": "./capabilities/playwright_edge_browser.manifest.json",
    "./mcp/playwright-edge": "./mcp/playwright-edge.ts",
    "./mcp/playwright-edge-provider": "./mcp/playwright-edge-provider.ts"
  },
  "files": [
    "capabilities",
    "mcp",
    "browser-runtime.ts",
    "manifest.ts",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@sciforge-ui/runtime-contract": "^1.0.0"
  }
}
