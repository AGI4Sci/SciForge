# SciForge Sci-Modality Router Service — copy to .env and fill in. NEVER commit real keys.

# Required: local SciForge Model Router /v1. The sci-modality worker must not
# call arbitrary external model providers directly.
SCIFORGE_MODEL_ROUTER_BASE_URL=http://127.0.0.1:3892/v1
SCIFORGE_MODEL_ROUTER_RUNTIME_API_KEY=replace-with-local-model-router-runtime-token
# Robustness lives here (the main agent cannot read these modalities): retry transient failures.
SCIMODALITY_MODEL_ROUTER_TIMEOUT_MS=180000   # per-attempt timeout; model routing + inference can be slow
SCIMODALITY_MODEL_ROUTER_MAX_ATTEMPTS=6      # total attempts before giving up
SCIMODALITY_MODEL_ROUTER_RETRY_BASE_MS=1500  # exponential backoff base (capped at 15s)

SCIMODALITY_ROUTER_HOST=127.0.0.1
SCIMODALITY_ROUTER_PORT=3898
SCIMODALITY_ROUTER_RUNTIME_TOKEN=replace-with-router-token
SCIMODALITY_ROUTER_MAX_BODY_BYTES=41943040
EXPERT_TRANSLATOR_MAX_BODY_BYTES=41943040

# Only for self-hosting local expert weights after license review:
# SCIFORGE_ENABLE_LOCAL_EXPERT_PROVIDER=1
# EXPERT_TRANSLATOR_RUNTIME_TOKEN=replace-with-local-expert-runtime-token
# EXPERT_MODEL_DIR=/absolute/path/to/licensed/expert-models
# PROT2TEXT_MODEL_DIR=/absolute/path/to/licensed/prot2text-checkpoint
