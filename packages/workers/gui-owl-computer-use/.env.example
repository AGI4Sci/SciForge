# Computer-use worker config. Copy to `.env` (gitignored); never commit real keys.
#
# Every computer-use and reflection model call uses the app-owned Model Router.
SCIFORGE_MODEL_ROUTER_BASE_URL=http://127.0.0.1:3892/v1
SCIFORGE_MODEL_ROUTER_MODEL=sciforge-router
SCIFORGE_MODEL_ROUTER_RUNTIME_API_KEY=replace-with-router-runtime-key

# Loop / safety
CUA_MAX_STEPS=20
# Sliding window: how many recent steps keep their screenshot in the routed prompt.
CUA_IMAGE_WINDOW=2
CUA_SETTLE_S=0.25
CUA_NONPROGRESS_LIMIT=3
# Optional reflection pass through the general vision route above. Keep off
# unless Model Router is running and the runtime API key is available here.
CUA_REFLECT=false
CUA_REFLECT_ESCALATE=2
# CUA_REFLECT_MODEL=        # optional separate model for reflection

# Real actions are OFF unless this is true and the managed MCP path supplies a
# valid signed invocation proof. A request-body approve flag is not authority.
CUA_ALLOW_EXECUTE=false
CUA_INVOCATION_PROOF_MODE=required
# Share a random per-launch secret only between the managed wrapper and worker.
# SCIFORGE_CUA_INVOCATION_SECRET=
SCIFORGE_CUA_INVOCATION_PROOF_TTL_MS=30000

# HTTP sidecar port (used by --http and the Kun computer_use tool provider).
CUA_PORT=3900
# Bearer token for POST /computer-use/run and /computer-use/cancel. The GUI
# launcher generates a random token per start; set this only for manual runs.
# CUA_SERVICE_TOKEN=
# CUA_ARTIFACT_DIR=./cua-runs
# Lease watchdog. The Registry only detects expiry; the Service closes the
# backend handle before releasing the lease.
CUA_LEASE_TTL_S=120
CUA_LEASE_REAPER_ENABLED=true
CUA_LEASE_REAPER_INTERVAL_S=5
# Artifact deletion is disabled when both values are zero.
CUA_ARTIFACT_RETENTION_S=0
CUA_ARTIFACT_MAX_RUNS=0

# Optional P3a browser-page backend. Start the trusted Node CDP adapter with
# the same random token. The adapter separately allowlists loopback CDP
# endpoints through SCIFORGE_CUA_CDP_ENDPOINTS; ordinary Chrome without an
# opened debugging endpoint cannot be attached.
# SCIFORGE_CUA_CDP_ADAPTER_URL=http://127.0.0.1:3909
# SCIFORGE_CUA_CDP_ADAPTER_TOKEN=replace-with-random-adapter-token

# P4 isolated-desktop is an SPI only. No RDP/VM/Sandbox provider ships with
# this worker, so it reports ISOLATED_DESKTOP_UNAVAILABLE by default.

# Paint a click-through highlight ring + ripple + banner on the real desktop
# during live execution so the user can see where/when the agent acts (Windows;
# no-op elsewhere). Set false to disable.
CUA_SHOW_OVERLAY=true
