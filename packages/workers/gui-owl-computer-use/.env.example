# Computer-use worker config. Copy to `.env` (gitignored); never commit real keys.
#
# Grounding model access. URL/model/header defaults are built into this package.
# Never commit real keys.
CUA_GROUNDING_API_KEY=replace-with-grounding-api-key
# Override only if the GUI-Owl gateway changes:
# CUA_GROUNDING_BASE_URL=http://10.140.158.130:8881/v1/chat/completions
# CUA_GROUNDING_MODEL=gui-owl
# CUA_GROUNDING_ENDPOINT=chat_completions
# CUA_GROUNDING_EXTRA_HEADERS={"x-original-model":"gui-owl"}
CUA_GROUNDING_DIM=1000

# Optional general vision route for reflection. Defaults to the local Model
# Router public alias (`sciforge-router`), whose routed vision model is managed
# by Model Router settings.
# CUA_VISION_BASE_URL=http://127.0.0.1:3892/v1
# CUA_VISION_MODEL=sciforge-router
# CUA_VISION_API_KEY=
# CUA_VISION_ENDPOINT=chat_completions

# Loop / safety
CUA_MAX_STEPS=20
# Sliding window: how many recent steps keep their screenshot in the routed prompt.
CUA_IMAGE_WINDOW=2
CUA_SETTLE_S=0.25
CUA_NONPROGRESS_LIMIT=3
# Optional reflection pass through the general vision route above. Keep off
# unless Model Router is running and the runtime API key is available here.
CUA_REFLECT=false
CUA_REFLECT_ESCALATE=2
# CUA_REFLECT_MODEL=        # optional separate model for reflection

# Real mouse/keyboard is OFF unless this is true AND the call sets execute+approve.
CUA_ALLOW_EXECUTE=false

# HTTP sidecar port (used by --http and the Kun computer_use tool provider).
CUA_PORT=3900
# Bearer token for POST /computer-use/run and /computer-use/cancel. The GUI
# launcher generates a random token per start; set this only for manual runs.
# CUA_SERVICE_TOKEN=
# CUA_ARTIFACT_DIR=./cua-runs

# Paint a click-through highlight ring + ripple + banner on the real desktop
# during live execution so the user can see where/when the agent acts (Windows;
# no-op elsewhere). Set false to disable.
CUA_SHOW_OVERLAY=true
