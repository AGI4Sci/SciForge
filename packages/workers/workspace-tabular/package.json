{
  "name": "@sciforge/workspace-tabular",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "description": "First-party SciForge workspace preview worker for bounded tabular text parsing and summaries.",
  "sciforge": {
    "lifecycleLayer": "workers",
    "skillFacing": false,
    "sideEffects": "none",
    "publicContract": true,
    "runtimeAdapter": false,
    "mcpServer": false
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./engine": "./src/workspace-tabular-engine.ts",
    "./service": "./src/service.ts"
  },
  "files": [
    "src",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.3",
    "jszip": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
