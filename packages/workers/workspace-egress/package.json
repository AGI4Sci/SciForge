{
  "name": "@sciforge/workspace-egress",
  "version": "0.1.8",
  "license": "MIT",
  "type": "module",
  "private": false,
  "description": "Workspace-scoped network egress leases and loopback HTTP CONNECT relay for SciForge.",
  "sciforge": {
    "lifecycleLayer": "workers",
    "skillFacing": false,
    "sideEffects": "network",
    "publicContract": true,
    "runtimeAdapter": false,
    "mcpServer": false
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./policy": "./src/policy.ts",
    "./process-environment": "./src/process-environment.ts",
    "./service": "./src/service.ts"
  },
  "files": [
    "src",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@sciforge/domain-sdk": "0.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
