    "./node/electron-node-executable": "./src/node/electron-node-executable.ts",
    "./node/runtime-mcp-launcher": "./src/node/runtime-mcp-launcher.ts",
    "./node/workspace-paths": "./src/node/workspace-paths.ts",
    "./power": "./src/power.ts",
    "./portable-resource-references": "./src/portable-resource-references.ts",
    "./principal": "./src/principal.ts",
    "./remote-approval": "./src/remote-approval.ts",
