[Unit]
Description=Back up the SciForge collaboration PostgreSQL database
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=sciforge_collab
Group=sciforge_collab
ExecStart=/usr/local/sbin/backup-sciforge-collaboration-db
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/sciforge-collaboration
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
