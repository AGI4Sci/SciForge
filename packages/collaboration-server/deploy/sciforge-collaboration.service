[Unit]
Description=SciForge collaboration server
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=sciforge_collab
Group=sciforge_collab
WorkingDirectory=/opt/sciforge-collaboration/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/sciforge/collaboration-server.env
ExecStart=/usr/bin/env node /opt/sciforge-collaboration/current/node_modules/@sciforge/collaboration-server/dist/cli.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077

# The service needs outbound HTTPS for the installed Human Endpoint provider,
# the local PostgreSQL socket, and its read-only release/config/secret files.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
