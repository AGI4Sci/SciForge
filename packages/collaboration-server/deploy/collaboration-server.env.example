# Install as /etc/sciforge/collaboration-server.env with mode 0640 and
# ownership root:sciforge_collab. This production example uses PostgreSQL
# local peer authentication and therefore contains no database password.
SCIFORGE_COLLABORATION_DATABASE_URL=postgresql://sciforge_collab@/sciforge_collaboration?host=/var/run/postgresql
SCIFORGE_COLLABORATION_DATABASE_POOL_SIZE=10
SCIFORGE_COLLABORATION_LISTEN_HOST=127.0.0.1
SCIFORGE_COLLABORATION_LISTEN_PORT=8787

# The existing Nginx location strips /collaboration before proxying.
SCIFORGE_COLLABORATION_BASE_PATH=

# The desktop Node WebSocket client normally sends no Origin. Add only exact,
# trusted browser origins if a browser client is enabled later.
SCIFORGE_COLLABORATION_ALLOWED_ORIGINS=

SCIFORGE_COLLABORATION_PROVIDER_CONFIG_FILE=/etc/sciforge/collaboration-providers.json
SCIFORGE_COLLABORATION_SECRET_DIRECTORY=/etc/sciforge/collaboration-secrets
