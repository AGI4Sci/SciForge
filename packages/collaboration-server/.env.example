# URL for the dedicated collaboration database. Keep the real value in the
# deployment secret manager; never commit it or print it in diagnostics.
SCIFORGE_COLLABORATION_DATABASE_URL=
SCIFORGE_COLLABORATION_DATABASE_POOL_SIZE=10
SCIFORGE_COLLABORATION_LISTEN_HOST=127.0.0.1
SCIFORGE_COLLABORATION_LISTEN_PORT=8787
SCIFORGE_COLLABORATION_BASE_PATH=
SCIFORGE_COLLABORATION_ALLOWED_ORIGINS=
SCIFORGE_COLLABORATION_OIDC_ISSUER=
SCIFORGE_COLLABORATION_OIDC_AUDIENCE=sciforge-cloud-api
SCIFORGE_COLLABORATION_OIDC_ALLOWED_AUTHORIZED_PARTIES=sciforge-desktop,sciforge-web-mobile
SCIFORGE_COLLABORATION_PROVIDER_CONFIG_FILE=
SCIFORGE_COLLABORATION_SECRET_DIRECTORY=
