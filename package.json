    "architecture-principles:test": "node --test ./scripts/architecture-principles-gate.test.mjs ./scripts/stage4-artifact-receipt.test.cjs ./scripts/domain-packages.test.mjs ./scripts/domain-package-tarball-smoke.test.mjs && node --import tsx --test ./scripts/private-skill-package.test.mjs && node ./scripts/architecture-principles-gate.mjs --changed-path-only",
    "architecture-principles:gate": "node ./scripts/architecture-principles-gate.mjs",
    "stage4:artifact:mac:arm64": "node ./scripts/stage4-artifact-build.mjs --platform mac --architecture arm64",
    "stage4:artifact:mac:x64": "node ./scripts/stage4-artifact-build.mjs --platform mac --architecture x64",
    "identity:keycloak:check": "node --test ./scripts/identity-access-docs.test.mjs ./scripts/keycloak-realm.test.mjs ./scripts/keycloak-test-deployment.test.mjs ./infra/keycloak/test/scripts/verify-oidc-artifacts.test.mjs ./infra/keycloak/test/scripts/verify-edge-contract.test.mjs",
    "identity:keycloak:login": "node ./scripts/keycloak-pkce-login.mjs",
    "smoke:domain-packages:tarball": "node --test ./scripts/domain-package-tarball-smoke.test.mjs",
    "package-versions:check": "node ./scripts/publishable-package-version-audit.mjs",
    "predomain-packages:typecheck": "npm run build:collaboration-dependencies",
    "domain-packages:typecheck": "node ./scripts/domain-packages.mjs --run typecheck",
    "extension-package:test": "node --test ./scripts/extension-package.test.mjs",
    "internal-overlay:test": "node --import tsx --test ./scripts/internal-overlay-package.test.mjs ./scripts/opencontent-team-delivery.test.mjs ./scripts/domain-package-deployment-config.test.cjs ./scripts/public-release-guard.test.cjs ./scripts/publish-r2.test.mjs && npm --workspace @sciforge/internal-runtime-integrity test",
