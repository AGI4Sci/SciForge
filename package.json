    "smoke:electron:source:cloud": "node ./scripts/e2e/product-stack-supervisor.mjs --config ./scripts/e2e/electron-domain-source-cloud.json",
    "smoke:electron:packaged": "node ./scripts/electron-domain-packaged-smoke.mjs",
