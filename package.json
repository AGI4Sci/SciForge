    "pretest": "npm run build:agent-support && npm run capability:check && npm run domain-sdk:test && npm run domain-packages:test && npm run internal-overlay:test && npm run extension-package:test",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "capability:generate": "node --import tsx ./scripts/capability-governance.mjs --write",
    "precapability:check": "npm run build:collaboration-dependencies",
    "capability:check": "npm run domain-packages:check && node --import tsx ./scripts/capability-governance.mjs --check",
    "dist": "npm run build && npx --yes electron-builder@26.8.1 --config electron-builder.config.cjs --publish never",
    "dist:dir": "npm run build && npx --yes electron-builder@26.8.1 --config electron-builder.config.cjs --publish never --dir",
    "license:package-audit": "node ./scripts/package-release-audit.mjs",
    "dist:mac": "node ./scripts/public-release-artifact-receipt.cjs clear --platform mac --dist dist && rm -f dist/SciForge-*-mac-* dist/latest-mac.yml && npm run build && npm run dist:mac:x64:artifacts && npm run dist:mac:arm64:artifacts && node ./scripts/generate-mac-latest.cjs dist && node ./scripts/public-release-artifact-receipt.cjs seal --platform mac --dist dist",
    "dist:mac:signed": "node ./scripts/public-release-artifact-receipt.cjs clear --platform mac --dist dist && rm -f dist/SciForge-*-mac-* dist/latest-mac.yml && MAC_SIGN=1 npm run dist:mac:x64 && MAC_SIGN=1 npm run dist:mac:arm64 && node ./scripts/generate-mac-latest.cjs dist && node ./scripts/public-release-artifact-receipt.cjs seal --platform mac --dist dist",
    "dist:mac:arm64": "npm run build && npm run dist:mac:arm64:artifacts",
    "dist:mac:x64": "npm run build && npm run dist:mac:x64:artifacts",
    "dist:mac:arm64:artifacts": "npx --yes electron-builder@26.8.1 --config electron-builder.config.cjs --publish never --mac dmg zip --arm64",
    "dist:mac:x64:artifacts": "npx --yes electron-builder@26.8.1 --config electron-builder.config.cjs --publish never --mac dmg zip --x64",
    "dist:win": "node ./scripts/public-release-artifact-receipt.cjs clear --platform win --dist dist && npm run dist -- --win nsis --x64 && node ./scripts/public-release-artifact-receipt.cjs seal --platform win --dist dist",
    "dist:linux": "node ./scripts/public-release-artifact-receipt.cjs clear --platform linux --dist dist && npm run dist -- --linux AppImage --x64 && node ./scripts/public-release-artifact-receipt.cjs seal --platform linux --dist dist",
