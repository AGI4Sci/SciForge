{
  "name": "@sciforge/plugin-scientific-plotting",
  "version": "0.4.0-mvp.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Scientific Figures: plotting and visual review with immutable workspace files in one DSH plugin.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/figure-store/*.test.ts src/sciforge/*.test.ts tests/mvp-*.test.ts"
  },
  "exports": {
    ".": "./dist/main.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "sciforge.dsh.json",
    "sciforge.adapter.json",
    "README.md",
    "NOTICE",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.10",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "esbuild": "^0.25.12",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "happy-dom": "20.11.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4 <0.3.0",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  }
}
