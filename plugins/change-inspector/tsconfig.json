{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "build.mjs"
  ]
}
