      "id": "anchored-comments.list",
      "scope": "workspace",
      "effect": "read",
      "tags": [
        "anchored-comments",
        "comment",
        "thread",
        "list",
        "评论",
        "锚定评论"
      ]
    },
    "anchored_comments_get": {
      "id": "anchored-comments.get",
