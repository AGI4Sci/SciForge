{
  "schemaVersion": 1,
  "packageName": "@sciforge/plugin-anchored-comments",
  "entry": "dist/main.js",
  "title": "Anchored Comments",
  "summary": {
    "zh": "独立锚定批注插件：通过工具或插件面板保存精确文字选区；业务状态与截图资产按宿主绑定工作区隔离。",
    "en": "Independent anchored comments tools and owner panel for exact text selections, with Host-bound workspace state and evidence assets."
  },
  "categories": [
    "collaboration",
    "evidence"
  ],
  "hostDependencies": [
    "@deepseek-ai/dsh-tools"
  ],
  "ports": [
    "visual-capture.read",
    "visual-capture.capture"
  ],
  "tools": {
