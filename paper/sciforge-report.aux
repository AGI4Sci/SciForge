\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces MolClaw iterative optimization trajectory for EGFR T790M kinase inhibitors. (a) Molecular structures of the best candidate from each round with docking scores and key physicochemical properties (MW, LogP, QED). (b) Score convergence from baseline Erlotinib ($-7.5$\nobreakspace  {}kcal/mol) to the final best candidate ($-9.8$\nobreakspace  {}kcal/mol). The 4-anilinoquinazoline scaffold is preserved throughout; modifications target R\textsubscript  {1} (C6), R\textsubscript  {2} (C7), R\textsubscript  {3} (gatekeeper meta), and R\textsubscript  {4} (aniline para) positions.}}{21}{figure.9}\protected@file@percent }
\newlabel{fig:molclaw-optimization}{{9}{21}{MolClaw iterative optimization trajectory for EGFR T790M kinase inhibitors. (a) Molecular structures of the best candidate from each round with docking scores and key physicochemical properties (MW, LogP, QED). (b) Score convergence from baseline Erlotinib ($-7.5$~kcal/mol) to the final best candidate ($-9.8$~kcal/mol). The 4-anilinoquinazoline scaffold is preserved throughout; modifications target R\textsubscript {1} (C6), R\textsubscript {2} (C7), R\textsubscript {3} (gatekeeper meta), and R\textsubscript {4} (aniline para) positions}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 4-Anilinoquinazoline scaffold modification strategy. The four modifiable positions (R\textsubscript  {1}--R\textsubscript  {4}) are annotated with the best substituent found in each round and the optimization strategy (exploration, exploitation, pivot) that discovered it. R\textsubscript  {2}=F and R\textsubscript  {4}=CF\textsubscript  {3} together produce the largest docking score improvement ($\Delta = -2.3$\nobreakspace  {}kcal/mol).}}{22}{figure.10}\protected@file@percent }
\newlabel{fig:molclaw-scaffold}{{10}{22}{4-Anilinoquinazoline scaffold modification strategy. The four modifiable positions (R\textsubscript {1}--R\textsubscript {4}) are annotated with the best substituent found in each round and the optimization strategy (exploration, exploitation, pivot) that discovered it. R\textsubscript {2}=F and R\textsubscript {4}=CF\textsubscript {3} together produce the largest docking score improvement ($\Delta = -2.3$~kcal/mol)}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces (Left) Docking score trajectory across six optimization rounds, showing progressive convergence from $-7.5$ to $-9.8$\nobreakspace  {}kcal/mol. (Right) Strategy effectiveness measured as $\Delta $Score contribution per round, comparing exploration, exploitation, and pivot strategies.}}{22}{figure.11}\protected@file@percent }
\newlabel{fig:molclaw-trajectory}{{11}{22}{(Left) Docking score trajectory across six optimization rounds, showing progressive convergence from $-7.5$ to $-9.8$~kcal/mol. (Right) Strategy effectiveness measured as $\Delta $Score contribution per round, comparing exploration, exploitation, and pivot strategies}{figure.11}{}}
