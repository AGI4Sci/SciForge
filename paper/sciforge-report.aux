\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Cross-Scale Cell Atlas from Multi-Database Integration}{17}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cross-Scale Cell Atlas Pipeline. The workflow executes on SciForge's remote execution infrastructure, spanning eight phases (P0--P7) from local frontend instruction through data retrieval and multi-layer processing to Evidence DAG--anchored output. Dashed arrows connect pipeline phases to the corresponding layers of the six-layer biology stack (L0--L5). Automated gate validation at P4/P5 and P7 enforces script-first evidence contracts and output completeness.}}{17}{figure.6}\protected@file@percent }
\newlabel{fig:cross-scale-pipeline}{{6}{17}{Cross-Scale Cell Atlas Pipeline. The workflow executes on SciForge's remote execution infrastructure, spanning eight phases (P0--P7) from local frontend instruction through data retrieval and multi-layer processing to Evidence DAG--anchored output. Dashed arrows connect pipeline phases to the corresponding layers of the six-layer biology stack (L0--L5). Automated gate validation at P4/P5 and P7 enforces script-first evidence contracts and output completeness}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cross-Scale Data Coverage Matrix for 15 representative ECCITE-seq CRISPR guide targets across the six biological layers (L0--L5). Coverage scores: 0\nobreakspace  {}=\nobreakspace  {}missing, 1\nobreakspace  {}=\nobreakspace  {}partial, 2\nobreakspace  {}=\nobreakspace  {}complete. Protein-level ADT measurements (L4) and DepMap gene-effect scores (L5) exhibit sparser coverage than annotation layers, reflecting the real-world data-integration challenges that the pipeline's automated gate validation is designed to detect.}}{18}{figure.7}\protected@file@percent }
\newlabel{fig:cross-scale-coverage}{{7}{18}{Cross-Scale Data Coverage Matrix for 15 representative ECCITE-seq CRISPR guide targets across the six biological layers (L0--L5). Coverage scores: 0~=~missing, 1~=~partial, 2~=~complete. Protein-level ADT measurements (L4) and DepMap gene-effect scores (L5) exhibit sparser coverage than annotation layers, reflecting the real-world data-integration challenges that the pipeline's automated gate validation is designed to detect}{figure.7}{}}
