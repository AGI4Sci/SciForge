#!/usr/bin/env python3
"""Regenerate molclaw_scaffold_strategy.png with clear R1-R6 labels ON the molecule.
Reviewer feedback: R1,R2,R3 need to be labeled directly on the molecular diagram;
text on the right-side cards is too small."""

import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch
from rdkit import Chem
from rdkit.Chem import Draw, AllChem
from rdkit.Chem.Draw import rdMolDraw2D
from io import BytesIO
from PIL import Image
import numpy as np
import warnings
warnings.filterwarnings('ignore')

plt.rcParams.update({
    'font.family': 'sans-serif',
    'font.size': 14,
    'axes.titlesize': 16,
    'axes.labelsize': 14,
    'figure.facecolor': 'white',
    'savefig.dpi': 300,
    'savefig.bbox': 'tight',
})

# ======== SCAFFOLD DATA ========
scaffold_smiles = 'COCCOc1cc2ncnc(Nc3ccccc3)c2cc1OCCOC'

# R-group positions: map RDKit atom indices to R-group labels
# Based on the 4-anilinoquinazoline scaffold parsed from SMILES
# Atom 9 is C2 (R5), atom 12 is NH bridge, atoms 13-18 are aniline ring
# R1 = meta to NH on aniline ring (atom 15 or 17)
# R2/R3 = solvent region on quinazoline (atoms 5-6 side chain, atoms 21-22 side chain)
# R5 = C2 position (atom 9)
# R6 = solvent-exposed (atoms 0-4 methoxyethoxy chain)

atom_labels = {
    15: ('R₁', '#2E86C1'),  # meta position on aniline ring (gatekeeper)
    5:  ('R₂', '#E74C3C'),  # solvent region on quinazoline
    21: ('R₃', '#27AE60'),  # solvent region on quinazoline (other side)
    9:  ('R₅', '#8E44AD'),  # C2 position
    0:  ('R₆', '#D4AC0D'),  # solvent-exposed methoxyethoxy
}

r_groups_detail = {
    'R₁': {'position': 'gatekeeper', 'best': 'CF₃', 'strategy': 'Exploration→Exploitation',
            'score': 'Δ = −1.7 kcal/mol', 'desc': 'CF₃ outperforms ethynyl\nby ~0.5–0.8 kcal/mol',
            'color': '#2E86C1'},
    'R₂': {'position': 'solvent region', 'best': 'OCH₂CF₃', 'strategy': 'Exploration→Pivot',
           'score': 'Δ ≈ −0.5 kcal/mol', 'desc': 'Best single-site\nmodification; OH\nalso favorable',
           'color': '#E74C3C'},
    'R₃': {'position': 'solvent region', 'best': 'F', 'strategy': 'Exploration',
           'score': 'Δ ≈ −0.3 kcal/mol', 'desc': 'F outperforms Cl\nby ~0.1–0.3 kcal/mol',
           'color': '#27AE60'},
    'R₅': {'position': 'C2 position', 'best': 'CH₃', 'strategy': 'Exploitation',
           'score': 'Δ ≈ −0.2 kcal/mol', 'desc': 'C2-methyl provides\nmodest improvement',
           'color': '#8E44AD'},
    'R₆': {'position': 'solvent-exposed', 'best': 'O(CH₂)₂OCH₃', 'strategy': 'Fixed (erlotinib)',
           'score': 'baseline scaffold', 'desc': 'Retained from\nparent erlotinib\nscaffold',
           'color': '#D4AC0D'},
}

# ======== DRAW MOLECULE WITH R-GROUP LABELS ON ATOMS ========
def draw_scaffold_with_atom_labels(smiles, size=(1200, 800)):
    """Draw scaffold with large R-group labels directly on atoms."""
    mol = Chem.MolFromSmiles(smiles)
    if mol is None:
        return None
    AllChem.Compute2DCoords(mol)

    drawer = rdMolDraw2D.MolDraw2DCairo(size[0], size[1])
    opts = drawer.drawOptions()
    opts.bondLineWidth = 5
    opts.baseFontSize = 0.85
    opts.clearBackground = True
    opts.addAtomIndices = False
    opts.includeAtomTags = False
    opts.includeRadicals = False
    opts.annotationFontScale = 1.2

    drawer.DrawMolecule(mol)
    drawer.FinishDrawing()

    img_data = drawer.GetDrawingText()
    img = Image.open(BytesIO(img_data))
    return img, drawer, mol

# Since RDKit's built-in atom annotations are limited, we'll use matplotlib
# to overlay annotations on the molecule image.
def create_annotated_molecule_figure():
    """Create a molecule figure with R-group labels overlaid."""
    mol = Chem.MolFromSmiles(scaffold_smiles)
    AllChem.Compute2DCoords(mol)

    # Get atom coordinates
    conf = mol.GetConformer()
    coords = {}
    for atom in mol.GetAtoms():
        pos = conf.GetAtomPosition(atom.GetIdx())
        coords[atom.GetIdx()] = (pos.x, pos.y)

    # Draw molecule
    drawer = rdMolDraw2D.MolDraw2DCairo(1200, 800)
    opts = drawer.drawOptions()
    opts.bondLineWidth = 5
    opts.baseFontSize = 0.75
    opts.clearBackground = True
    opts.addAtomIndices = False

    # Highlight atoms with R-group colors
    highlight_atoms = []
    highlight_colors = {}
    for aidx, (label, color) in atom_labels.items():
        r, g, b = int(color[1:3], 16)/255, int(color[3:5], 16)/255, int(color[5:7], 16)/255
        highlight_atoms.append(aidx)
        highlight_colors[aidx] = (r, g, b)

    drawer.DrawMolecule(mol, highlightAtoms=highlight_atoms,
                        highlightAtomColors=highlight_colors)
    drawer.FinishDrawing()

    img_data = drawer.GetDrawingText()
    mol_img = Image.open(BytesIO(img_data))

    # Now overlay R-group labels using PIL
    from PIL import ImageDraw, ImageFont
    draw = ImageDraw.Draw(mol_img)

    # Scale coordinates to image dimensions
    # RDKit coords need to be mapped to pixel space
    xs = [c[0] for c in coords.values()]
    ys = [c[1] for c in coords.values()]
    x_min, x_max = min(xs), max(xs)
    y_min, y_max = min(ys), max(ys)

    margin = 80
    scale_x = (1200 - 2*margin) / (x_max - x_min) if x_max != x_min else 1
    scale_y = (800 - 2*margin) / (y_max - y_min) if y_max != y_min else 1

    try:
        font = ImageFont.truetype("/System/Library/Fonts/Helvetica.ttc", 36)
        font_small = ImageFont.truetype("/System/Library/Fonts/Helvetica.ttc", 28)
    except:
        font = ImageFont.load_default()
        font_small = ImageFont.load_default()

    for aidx, (label, color) in atom_labels.items():
        if aidx in coords:
            px = margin + int((coords[aidx][0] - x_min) * scale_x)
            py = 800 - margin - int((coords[aidx][1] - y_min) * scale_y)
            # Draw colored circle background
            r = 30
            draw.ellipse([px-r, py-r, px+r, py+r], fill=color + 'CC', outline=color, width=3)
            # Draw label text
            bbox = draw.textbbox((0, 0), label, font=font)
            tw, th = bbox[2]-bbox[0], bbox[3]-bbox[1]
            draw.text((px-tw/2, py-th/2-2), label, fill='white', font=font)

    return mol_img

# ======== CREATE FIGURE ========
fig = plt.figure(figsize=(26, 18))

# ---- Left half: Scaffold with atom-level annotations ----
ax_mol = fig.add_axes([0.01, 0.08, 0.52, 0.84])
ax_mol.axis('off')

mol_img = create_annotated_molecule_figure()
if mol_img:
    ax_mol.imshow(mol_img)

ax_mol.set_title('4-Anilinoquinazoline Scaffold\nModification Sites (R₁–R₆)', 
                 fontsize=18, fontweight='bold', pad=12, color='#2C3E50')

# ---- Right half: R-group detail cards (larger text) ----
gs_right = fig.add_gridspec(5, 1, left=0.56, right=0.99, top=0.94, bottom=0.06, hspace=0.12)

for i, (r_label, info) in enumerate(r_groups_detail.items()):
    ax_card = fig.add_subplot(gs_right[i])
    ax_card.set_xlim(0, 10)
    ax_card.set_ylim(0, 1)
    ax_card.axis('off')

    # Background card with larger padding
    card = FancyBboxPatch((0.05, 0.02), 9.9, 0.96, boxstyle="round,pad=0.12",
                          facecolor=info['color'], alpha=0.10,
                          edgecolor=info['color'], linewidth=2.5)
    ax_card.add_patch(card)

    # Left colored indicator bar
    bar = FancyBboxPatch((0.05, 0.12), 0.18, 0.76, boxstyle="round,pad=0.03",
                         facecolor=info['color'], alpha=0.85)
    ax_card.add_patch(bar)

    # R-group label (LARGE)
    ax_card.text(0.55, 0.78, r_label, fontsize=24, fontweight='bold',
                color=info['color'], va='center')

    # Best substituent (LARGE)
    ax_card.text(0.55, 0.40, info['best'], fontsize=28, fontweight='bold',
                color='#2C3E50', va='center')

    # Strategy label
    ax_card.text(2.8, 0.78, f'Strategy: {info["strategy"]}', fontsize=15,
                color='#444444', va='center',
                bbox=dict(boxstyle='round,pad=0.25', facecolor='white', alpha=0.85,
                         edgecolor='#CCCCCC'))

    # Score improvement
    ax_card.text(2.8, 0.40, info['score'], fontsize=16,
                color='#27AE60', va='center', fontweight='bold')

    # Description
    ax_card.text(7.2, 0.50, info['desc'], fontsize=15, color='#333333',
                va='center', ha='left')

fig.suptitle('4-Anilinoquinazoline Scaffold Modification Strategy\nBest Substituent per Position with Atom-Level Annotations',
             fontsize=20, fontweight='bold', y=0.995, color='#2C3E50')

output_path = 'molclaw_scaffold_strategy.png'
fig.savefig(output_path, dpi=300, bbox_inches='tight', facecolor='white', edgecolor='none')
plt.close()
print(f'Scaffold strategy saved: {output_path}')
