% === Metadata ===
\title[SciForge: Multimodal Research-Native AI Workbench]{SciForge: A Multimodal Research-Native AI Workbench for Scientific Discovery}

\author*[1]{\fnm{Author} \sur{Names}}\email{author@example.com}

\affil*[1]{\orgdiv{Institute}, \orgname{University}, \orgaddress{\city{City}, \country{Country}}}

% === Abstract keywords ===
\abstract{
Scientific work increasingly spans heterogeneous artifacts: papers, code, datasets, scientific file formats, model outputs, figures, manuscripts, and team decisions. General-purpose AI assistants can answer questions or operate tools, but they rarely preserve these objects as a coherent, long-running, and auditable research state. We present SciForge, a multimodal research-native AI workbench for scientific discovery. SciForge follows a local-first architecture in which the graphical interface is reserved for human judgment, while search, scientific parsing, model routing, workflow execution, plotting, writing, and presentation generation run as modular agent-accessible services. SciForge is built around three co-equal design pillars: (i) \emph{translate-then-reason} for \textbf{multimodal} input---scientific objects such as protein sequences, structures, molecules, and cell-omics data are routed through domain translators before the main agent reasons over provenance-rich evidence; (ii) \emph{evidence governance} for \textbf{auditable} traceability---every agent action, generated artifact, and manuscript claim is linked to its provenance chain; and (iii) \emph{team-governed execution} for \textbf{collaborative} research---with role-based approvals, cross-session handoffs, and shared review surfaces. The system combines a thin Desktop/Group/Mobile interaction layer, Research Applications for key human decisions, an Agent Runtime and Workflow Engine, a Scientific Model Router, and local scientific memory backed by reusable worker services. Compared with GUI workbenches, terminal workbenches, and API-based scientific agents, SciForge emphasizes an integrated local workspace, multimodal scientific evidence, modular capability reuse, and human-governed research automation.
}

\keywords{SciForge, AI workbench, scientific discovery, agentic workflow, evidence-aware AI, multimodal science, research automation}

