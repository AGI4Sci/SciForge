# SciForge Computer-Use plugin — config. Copy to `.env` (gitignored); never commit real keys.

# Planner / reasoner (OpenAI-compatible). qwen3.7-plus via the model gateway.
CUA_PLANNER_BASE_URL=http://YOUR_GATEWAY_HOST:3888/v1
CUA_PLANNER_API_KEY=
CUA_PLANNER_MODEL=qwen3.7-plus

# Dedicated grounder (GUI-Owl-1.5 served by vLLM). Local, or an SSH-forwarded port.
CUA_GROUNDER_BASE_URL=http://127.0.0.1:18901/v1
CUA_GROUNDER_API_KEY=EMPTY
CUA_GROUNDER_MODEL=gui-owl-1.5-8b
CUA_GROUNDING_DIM=1000

# Loop / safety
CUA_MAX_STEPS=15
CUA_ALLOW_EXECUTE=false        # must be true (and call with execute+approve) for real actions
CUA_PORT=3900
# CUA_ARTIFACT_DIR=./cua-runs

# Mouse visualization: paint a click-through highlight ring + ripple + banner on
# the real desktop during live execution so the user can see where/when the agent
# acts (Windows; no-op on other platforms). Set false to disable.
CUA_SHOW_OVERLAY=true
