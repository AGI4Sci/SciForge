{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node", "vite/client"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "extensions/research-memory/src/**/*",
    "packages/workers/evidence-dag/desktop/**/*",
    "packages/workers/project-dag/desktop/**/*"
  ]
}
